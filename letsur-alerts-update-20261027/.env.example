# Slack 봇 설정 예시. 이 파일을 .env로 복사한 뒤 값을 채웁니다(RUNNING.md, SLACK_SETUP.md).
# .env는 .gitignore에 들어 있어 저장소에 올라가지 않습니다. 이 예시 파일에는 실제 값을 절대 넣지 않습니다.
# GitHub 토큰과 렛서 API 키는 여기에 넣지 않습니다.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
# 공개 요청 주소 방식으로 버튼을 받을 때만 씁니다(지금은 Socket Mode라 비워 둠).
# SLACK_SIGNING_SECRET=
