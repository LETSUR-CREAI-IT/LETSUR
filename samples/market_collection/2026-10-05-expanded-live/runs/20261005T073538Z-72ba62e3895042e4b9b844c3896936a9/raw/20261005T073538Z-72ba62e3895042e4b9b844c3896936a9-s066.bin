",null,{\"id\":\"model-explore-heading\",\"children\":\"Explore more models\",\"data-_gt\":\"$undefined\"}]\n86:T6b3,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is GLM 5.2?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GLM 5.2 is a large-scale reasoning model from Z.ai. It supports text input and output with a 1M-token context window, and is suited for long-horizon agent workflows, project-level software engineering, and complex multi-step automation. Reasoning efforts high and xhigh are supported; xhigh maps to max reasoning.\"}},{\"@type\":\"Question\",\"name\":\"How much does GLM 5.2 cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GLM 5.2 costs $0.0224/M input tokens and $16.00/M output tokens, with separate rates for Cache Read at $0.0224/M tokens.\"}},{\"@type\":\"Question\",\"name\":\"What is the context length of GLM 5.2?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GLM 5.2 has a 1,048,576 token context window. It supports up to 131,072 completion tokens.\"}},{\"@type\":\"Question\",\"name\":\"Does GLM 5.2 support tool calling and structured outputs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. GLM 5.2 accepts tools and tool_choice for function calling. It also supports structured outputs via a JSON schema in response_format.\"}},{\"@type\":\"Question\",\"name\":\"Which providers serve GLM 5.2?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GLM 5.2 is served by 25 providers on OpenRouter: Relace, inference.net, Wafer, Morph, Decart Fast, DeepInfra, StreamLake, NovitaAI and 17 more. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with provider routing.\"}},{\"@type\":\"Question\",\"name\":\"When was GLM 5.2 released?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GLM 5.2 was released on June 16, 2026.\"}}]}7d:[[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"scroll-mt-[calc(var(--navbar-height)+129px+var(--sticky-banner-top,0px))] lg:scroll-mt-[calc(var(--navbar-height)+70px+var(--sticky-banner-top,0px))] mb-10 last:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-4 gap-y-2 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-4 w-4 shrink-0 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-base font-medium\",\"children\":\"Frequently asked questions\"}],\"$undefined\"]}],null]}],null,[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border border-none p-0\",\"children\":[\"$\",\"$L85\",null,{\"faqs\":[{\"question\":\"What is GLM 5.2?\",\"answer\":\"GLM 5.2 is a large-scale reasoning model from Z.ai. It supports text input and output with a 1M-token context window, and is suited for long-horizon agent workflows, project-level software engineering, and complex multi-step automation. Reasoning efforts high and xhigh are supported; xhigh maps to max reasoning.\",\"isCustom\":false},{\"question\":\"How much does GLM 5.2 cost?\",\"answer\":\"GLM 5.2 costs $0.0224/M input tokens and $16.00/M output tokens, with separate rates for Cache Read at $0.0224/M tokens.\",\"isCustom\":false},{\"question\":\"What is the context length of GLM 5.2?\",\"answer\":\"GLM 5.2 has a 1,048,576 token context window. It supports up to 131,072 completion tokens.\",\"isCustom\":false},{\"question\":\"Does GLM 5.2 support tool calling and structured outputs?\",\"answer\":\"Yes. GLM 5.2 accepts `tools` and `tool_choice` for function calling. It also supports structured outputs via a JSON schema in `response_format`.\",\"isCustom\":false},{\"question\":\"Which providers serve GLM 5.2?\",\"answer\":\"GLM 5.2 is served by 25 providers on OpenRouter: Relace, inference.net, Wafer, Morph, Decart Fast, DeepInfra, StreamLake, NovitaAI and 17 more. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with [provider routing](/docs/features/provider-routing).\",\"isCustom\":false},{\"question\":\"When was GLM 5.2 released?\",\"answer\":\"GLM 5.2 was released on June 16, 2026.\",\"isCustom\":false}],\"modelPermaslug\":\"z-ai/glm-5.2-20260616\",\"modelSlug\":\"z-ai/glm-5.2\"}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$86\"}}]]\n"])</script><script>self.__next_f.push([1,"87:I[743425,[\"/_next/static/immutable/chunks/1zet098htcd4i.js\",\"/_next/static/immutable/chunks/1ncwfr4wdrrub.js\",\"/_next/static/immutable/chunks/2xgvr_umi0kh_.js\",\"/_next/static/immutable/chunks/0fm-u2k-im7-i.js\",\"/_next/static/immutable/chunks/1m2s60egjx067.js\",\"/_next/static/immutable/chunks/1xgt1odsntw54.js\",\"/_next/static/immutable/chunks/2osv2vgv9ppxf.js\",\"/_next/static/immutable/chunks/3d265-i4j720s.js\",\"/_next/static/immutable/chunks/3d304w99n_8rh.js\",\"/_next/static/immutable/chunks/1ean_2r1sqb1a.js\",\"/_next/static/immutable/chunks/3x8ioig9pq1hs.js\",\"/_next/static/immutable/chunks/2z37o0kvy2cxn.js\",\"/_next/static/immutable/chunks/04f9q5seg6ynq.js\",\"/_next/static/immutable/chunks/1kagc9nrffwf9.js\",\"/_next/static/immutable/chunks/0xx-m2qvixggl.js\",\"/_next/static/immutable/chunks/0wcm69-h4pbvk.js\",\"/_next/static/immutable/chunks/1b1dei65dj1u8.js\",\"/_next/static/immutable/chunks/3u12a6raqlp3z.js\"