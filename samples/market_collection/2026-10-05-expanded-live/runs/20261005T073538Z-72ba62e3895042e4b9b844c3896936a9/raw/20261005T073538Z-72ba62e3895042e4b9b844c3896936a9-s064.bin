\",\"/_next/static/immutable/chunks/2ddt1_htigrdd.js\",\"/_next/static/immutable/chunks/26586yzglkebv.js\",\"/_next/static/immutable/chunks/0_e6m9d27fkzg.js\",\"/_next/static/immutable/chunks/2b5rclvkjaspp.js\",\"/_next/static/immutable/chunks/23q2j2v9yscsc.js\",\"/_next/static/immutable/chunks/0h970vx1kmz59.js\",\"/_next/static/immutable/chunks/2b_ifxqt7p7pj.js\",\"/_next/static/immutable/chunks/3vnq1t3eo4po1.js\",\"/_next/static/immutable/chunks/0gbzi12qx0v4k.js\",\"/_next/static/immutable/chunks/1umfhkwnaf1km.js\"],\"ModelFaqList\"]\n102:null\n105:[\"$\",\"h2\",null,{\"id\":\"model-explore-heading\",\"children\":\"Explore more models\",\"data-_gt\":\"$undefined\"}]\n10c:T811,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is DeepSeek V4.1 Flash?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash is a sparse mixture-of-experts model from DeepSeek, and the first built on the company's Causal Encoder-Decoder (CED) architecture. It activates 8B parameters on input and 16B on output from a 552B-parameter backbone, an asymmetric split that keeps per-token compute low relative to the model's total size.\"}},{\"@type\":\"Question\",\"name\":\"How much does DeepSeek V4.1 Flash cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash costs $0.003/M input tokens and $2.40/M output tokens, with separate rates for Cache Read at $0.003/M tokens.\"}},{\"@type\":\"Question\",\"name\":\"What is the context length of DeepSeek V4.1 Flash?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash has a 1,048,576 token context window. It supports up to 1,048,576 completion tokens.\"}},{\"@type\":\"Question\",\"name\":\"Does DeepSeek V4.1 Flash support tool calling and structured outputs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. DeepSeek V4.1 Flash accepts tools and tool_choice for function calling. It also supports structured outputs via a JSON schema in response_format.\"}},{\"@type\":\"Question\",\"name\":\"What inputs and outputs does DeepSeek V4.1 Flash support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash accepts text and images as input and returns text.\"}},{\"@type\":\"Question\",\"name\":\"Which providers serve DeepSeek V4.1 Flash?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash is served by 28 providers on OpenRouter: Relace, Morph, inference.net, Wafer, Sail Research, Decart, Ionstream, DekaLLM and 20 more. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with provider routing.\"}},{\"@type\":\"Question\",\"name\":\"When was DeepSeek V4.1 Flash released?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"DeepSeek V4.1 Flash was released on September 10, 2026.\"}}]}103:[[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"scroll-mt-[calc(var(--navbar-height)+129px+var(--sticky-banner-top,0px))] lg:scroll-mt-[calc(var(--navbar-height)+70px+var(--sticky-banner-top,0px))] mb-10 last:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-4 gap-y-2 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-4 w-4 shrink-0 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-base font-medium\",\"children\":\"Frequently asked questions\"}],\"$undefined\"]}],null]}],null,[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border border-none p-0\",\"children\":[\"$\",\"$L10b\",null,{\"faqs\":[{\"question\":\"What is DeepSeek V4.1 Flash?\",\"answer\":\"DeepSeek V4.1 Flash is a sparse mixture-of-experts model from DeepSeek, and the first built on the company's Causal Encoder-Decoder (CED) architecture. It activates 8B parameters on input and 16B on output from a 552B-parameter backbone, an asymmetric split that keeps per-token compute low relative to the model's total size.\",\"isCustom\":false},{\"question\":\"How much does DeepSeek V4.1 Flash cost?\",\"answer\":\"DeepSeek V4.1 Flash costs $0.003/M input tokens and $2.40/M output tokens, with separate rates for Cache Read at $0.003/M tokens.\",\"isCustom\":false},{\"question\":\"What is the context length of DeepSeek V4.1 Flash?\",\"answer\":\"DeepSeek V4.1 Flash has a 1,048,576 token context window. It supports up to 1,048,576 completion tokens.\",\"isCustom\":false},{\"question\":\"Does DeepSeek V4.1 Flash support tool calling and structured outputs?\",\"answer\":\"Yes. DeepSeek V4.1 Flash accepts `tools` and `tool_choice` for function calling. It also supports structured outputs via a JSON schema in `response_format`.\",\"isCustom\":false},{\"question\":\"What inputs and outputs does DeepSeek V4.1 Flash support?\",\"answer\":\"DeepSeek V4.1 Flash accepts text and images as input and returns text.\",\"isCustom\":false},{\"question\":\"Which providers serve DeepSeek V4.1 Flash?\",\"answer\":\"DeepSeek V4.1 Flash is served by 28 providers on OpenRouter: Relace, Morph, inference.net, Wafer, Sail Research, Decart, Ionstream, DekaLLM and 20 more. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with [provider routing](/docs/features/provider-routing).\",\"isCustom\":false},{\"question\":\"When was DeepSeek V4.1 Flash released?\",\"answer\":\"DeepSeek V4.1 Flash was released on September 10, 2026.\",\"isCustom\":false}],\"modelPermaslug\":\"deepseek/deepseek-v4.1-flash-20260910\",\"modelSlug\":\"deepseek/deepseek-v4.1-flash\"}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10c\"}}]]\n"])</script><script>self.__next_f.push([1,"10d:I[743425,[\"/_next/static/immutable/chunks/1zet098htcd4i.js\",\"/_next/static/immutable/chunks/1ncwfr4wdrrub.js\",\"/_next/static/immutable/chunks/2xgvr_umi0kh_.js\",\"/_next/static/immutable/chunks/0fm-u2k-im7-i.js\",\"/_next/static/immutable/chunks/1m2s60egjx067.js\",\"/_next/static/immutable/chunks/1xgt1odsntw54.js\",\"/_next/static/immutable/chunks/2osv2vgv9ppxf.js\",\"/_next/static/immutable/chunks/3d265-i4j720s.js\",\"/_next/static/immutable/chunks/3d304w99n_8rh.js\",\"/_next/static/immutable/chunks/1ean_2r1sqb1a.js\",\"/_next/static/immutable/chunks/3x8ioig9pq1hs.js\",\"/_next/static/immutable/chunks/2z37o0kvy2cxn.js\",\"/_next/static/immutable/chunks/04f9q5seg6ynq.js\",\"/_next/static/immutable/chunks/1kagc9nrffwf9.js\",\"/_next/static/immutable/chunks/0xx-m2qvixggl.js\",\"/_next/static/immutable/chunks/0wcm69-h4pbvk.js\",\"/_next/static/immutable/chunks/1b1dei65dj1u8.js\",\"/_next/static/immutable/chunks/3u12a6raqlp3z.js\",\"/_next/static/immutable/chunks/23bgzjyllw6ce.js\",\"/_next/static/immutable/chunks/2dlk6ue5fqzqw.js\",\"/_next/static/immutable/chunks/32gi2t7999a4p.js\",\"/_next/static/immutable/chunks/2pa5k7vb3uyyk.js\",\"/_next/static/immutable/chunks/1x-jrijvpg9ny.js\",\"/_next/static/immutable/chunks/2s4sdu6_x4zzb.js\",\"/_next/static/immutable/chunks/3e2_aff5l81wj.js\",\"/_next/static/immutable/chunks/1-xb2tmx4nbo6.js\",\"/_next/static/immutable/chunks/0fn7t76vx9tgr.js\",\"/_next/static/immutable/chunks/1t4gy1s7qxvbt.js\",\"/_next/static/immutable/chunks/413rqze0gihba.js\",\"/_next/static/immutable/chunks/2tpu6hht-gj2o.js\",\"/_next/static/immutable/chunks/0n-1ujzdh2hh2.js\",\"/_next/static/immutable/chunks/15juq-n7yqnhb.js\",\"/_next/static/immutable/chunks/1rz-y2_97mit1.js\",\"/_next/static/immutable/chunks/10fx1jlpx4dzx.js\",\"/_next/static/immutable/chunks/29obs3y5-osat.js\",\"/_next/static/immutable/chunks/2jskfwmmjy1yt.js\",\"/_next/static/immutable/chunks/1h4z006n4_lge.js\",\"/_next/static/immutable/chunks/1rb_uv-ooq9re.js\",\"/_next/static/immutable/chunks/3ui39chdx6c6x.js\",\"/_next/static/immutable/chunks/2ddt1_htigrdd.js\",\"/_next/static/immutable/chunks/26586yzglkebv.js\",\"/_next/static/immutable/chunks/0_e6m9d27fkzg.js\",\"/_next/static/immutable/chunks/2b5rclvkjaspp.js\",\"/_next/static/immutable/chunks/23q2j2v9yscsc.js\",\"/_next/static/immutable/chunks/0h970vx1kmz59.js\",\"/_next/static/immutable/chunks/2b_ifxqt7p7pj.js\",\"/_next/static/immutable/chunks/3vnq1t3eo4po1.js\",\"/_next/static/immutable/chunks/0gbzi12qx0v4k.js\",\"/_next/static/immutable/chunks/1umfhkwnaf1km.js\",\"/_next/static/immutable/chunks/36c8el0p9-tlj.js\",\"/_next/static/immutable/chunks/2fhe81i0ltiwf.js\",\"/_next/static/immutable/chunks/33_ri5_esgc3v.js\",\"/_next/static/immutable/chunks/0l306aw9hyo7o.js\",\"/_next/static/immutable/chunks/18uwb90v6lh7d.js\",\"/_next/static/immutable/chunks/40vickqs9aw4q.js\",\"/_next/static/immutable/chunks/3nr0_3g900zt6.js\"],\"HydrationBoundary\"]\n10e:T45c,DeepSeek V4.1 Flash is a sparse mixture-of-experts model from DeepSeek, and the first built on the company's Causal Encoder-Decoder (CED) architecture. It activates 8B parameters on input and 16B on output from a 552B-parameter backbone, an asymmetric split that keeps per-token compute low relative to the model's total size. Image understanding is native to the architecture, with visual and text embeddings trained jointly from the start of pre-training rather than added afterward as in the earlier experimental [V4 Flash Vision Exp](https://openrouter.ai/deepseek/deepseek-v4-flash-vision-exp).\n\nIt is suited for coding, terminal, and computer-use agents, along with long-horizon tasks that must run to completion across many steps and long-context analysis. Compressed KV caching cuts cache memory to roughly a quarter of the previous Flash generation, significantly reducing costs on agentic workloads. DeepSeek positions it as the cost-efficient tier of the V4.1 family and reports that it exceeds [V4 Pro](https://openrouter.ai/deepseek/deepseek-v4-pro-0813) on performance, speed, and task completion time.10f:T45c,DeepSeek V4.1 Flash is a sparse mixture-of-experts model from DeepSeek, and the first built on the company's Causal Encoder-Decoder (CED) architecture. It activates 8B parameters on input and 16B on output from a 552B-parameter backbone, an asymmetric split that keeps per-token compute low relative to the model's total size. Image understanding is native to the architecture, with visual and text embeddings trained jointly from the start of pre-training rather than added afterward as in the earlier experimental [V4 Flash Vision Exp](https://openrouter.ai/deepseek/deepseek-v4-flash-vision-exp).\n\nIt is suited for coding, terminal, and computer-use agents, along with long-horizon tasks that must run to completion across many steps and long-context analysis. Compressed KV caching cuts cache memory to roughly a quarter of the previous Flash generation, significantly reducing costs on agentic workloads. DeepSeek positions it as the cost-efficient tier of the V4.1 family and reports that it exceeds [V4 Pro](https://openrouter.ai/deepseek/deepseek-v4-pro-0813) on performance, speed, and task completion time.110:T45c,DeepSeek V4.1 Flash is a sparse mixture-of-experts model from DeepSeek, and the first built on the company's Causal Encoder-Decoder (CED) architecture. It activates 8B parameters on input and 16B on output from a 552B-parameter backbone, an asymmetric split that keeps per-token compute low relative to the model's total size. Image understanding is native to the architecture, with visual and text embeddings trained jointly from th