     <tr><td tabindex="-1">Geo CRIS (US)</td><td tabindex="-1">$66.00</td><td tabindex="-1">$82.50</td><td tabindex="-1">$6.60</td><td tabindex="-1">$330.00</td></tr>
     <tr><td tabindex="-1">Global CRIS</td><td tabindex="-1">$60.00</td><td tabindex="-1">$75.00</td><td tabindex="-1">$6.00</td><td tabindex="-1">$300.00</td></tr>
