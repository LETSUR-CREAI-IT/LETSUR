     <tr><td tabindex="-1"><code class="code">ap-northeast-2</code> (Seoul)</td><td align="center" style="text-align: center;" tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-no.png" alt="not-supported" style="max-width:10px" height="10px" /></td><td align="center" style="text-align: center;" tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-no.png" alt="not-supported" style="max-width:10px" height="10px" /></td><td align="center" style="text-align: center;" tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-yes.png" alt="supported" style="max-width:10px" height="10px" /></td></tr>
