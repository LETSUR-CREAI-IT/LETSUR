      <th><b>Inference option</b></th>
      <th><b>Input</b></th>
      <th><b>Input — 30m cache write</b></th>
      <th><b>Input — cache read</b></th>
      <th><b>Output</b></th>
     </tr>
    </thead>
     <tr><td tabindex="-1">In-Region</td><td tabindex="-1">$4.40</td><td tabindex="-1">$5.50</td><td tabindex="-1">$0.44</td><td tabindex="-1">$22.00</td></tr>
     <tr><td tabindex="-1">Geo CRIS</td><td tabindex="-1">$4.40</td><td tabindex="-1">$5.50</td><td tabindex="-1">$0.44</td><td tabindex="-1">$22.00</td></tr>
     <tr><td tabindex="-1">Global CRIS</td><td tabindex="-1">$4.00</td><td tabindex="-1">$5.00</td><td tabindex="-1">$0.40</td><td tabindex="-1">$20.00</td></tr>
