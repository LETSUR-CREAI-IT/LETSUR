ice\":\"0.000012\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000003\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00000003\",\"completion\":\"0.000012\",\"input_cache_read\":\"0.00000003\",\"discount\":0}}},{\"slug\":\"z-ai/glm-5.3\",\"permaslug\":\"z-ai/glm-5.3-20260816\",\"name\":\"Z.ai: GLM 5.3 (batch)\",\"description\":\"GLM-5.3 is a large-scale reasoning model from Z.ai, built for complex software engineering and long-horizon agent tasks. It supports text input and output with a 1M-token context window, and improves on GLM-5.2 in coding and in the balance between performance and token efficiency.\\n\\nReasoning is always on and cannot be disabled. Reasoning efforts `low`, `high`, and `max` are supported; `max` is the default.\",\"created_at\":\"2026-08-18T20:57:35.738Z\",\"context_length\":1048576,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5.3:batch\",\"model_variant_permaslug\":\"z-ai/glm-5.3-20260816:batch\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.00000045\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000002\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00000045\",\"completion\":\"0.000002\",\"input_cache_read\":\"0.0000001\",\"discount\":0.375}}},{\"slug\":\"z-ai/glm-5.2\",\"permaslug\":\"z-ai/glm-5.2-20260616\",\"name\":\"Z.ai: GLM 5.2\",\"description\":\"GLM 5.2 is a large-scale reasoning model from Z.ai. It supports text input and output with a 1M-token context window, and is suited for long-horizon agent workflows, project-level software engineering, and complex multi-step automation.\\n\\nReasoning efforts `high` and `xhigh` are supported; `xhigh` maps to max reasoning. It is particularly strong at coding and tool use across long-running tasks, able to maintain engineering context and follow standards consistently through a full development workflow, from requirements to multi-platform deployment, in a single task.\",\"created_at\":\"2026-06-16T17:45:30.803Z\",\"context_length\":1048576,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5.2\",\"model_variant_permaslug\":\"z-ai/glm-5.2-20260616\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000000224\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000016\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000000224\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000000224\",\"completion\":\"0.000016\",\"input_cache_read\":\"0.0000000224\",\"discount\":0}}},{\"slug\":\"z-ai/glm-5.1\",\"permaslug\":\"z-ai/glm-5.1-20260406\",\"name\":\"Z.ai: GLM 5.1\",\"description\":\"GLM-5.1 delivers a major leap in coding capability, with particularly significant gains in handling long-horizon tasks. Unlike previous models built around minute-level interactions, GLM-5.1 can work independently and continuously on a single task for more than 8 hours, autonomously planning, executing, and improving itself throughout the process, ultimately delivering complete, engineering-grade results.\",\"created_at\":\"2026-04-07T16:07:05.031Z\",\"context_length\":204800,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5.1\",\"model_variant_permaslug\":\"z-ai/glm-5.1-20260406\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000000966\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000003036\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000001794\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.000000966\",\"completion\":\"0.000003036\",\"input_cache_read\":\"0.0000001794\",\"discount\":0.31}}},{\"slug\":\"z-ai/glm-5v-turbo\",\"permaslug\":\"z-ai/glm-5v-turbo-20260401\",\"name\":\"Z.ai: GLM 5V Turbo\",\"description\":\"GLM-5V-Turbo is Z.ai’s first native multimodal agent foundation model, built for vision-based coding and agent-driven tasks. It natively handles image, video, and text inputs, excels at long-horizon planning, complex coding, and task execution, and works seamlessly with agents to complete the full loop of “perceive → plan → execute“.\",\"created_at\":\"2026-04-01T16:37:38.290Z\",\"context_length\":202752,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5v-turbo\",\"model_variant_permaslug\":\"z-ai/glm-5v-turbo-20260401\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"1.2e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"4e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.24e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000012\",\"completion\":\"0.000004\",\"input_cache_read\":\"0.00000024\",\"discount\":0}}},{\"slug\":\"z-ai/glm-5-turbo\",\"permaslug\":\"z-ai/glm-5-turbo-20260315\",\"name\":\"Z.ai: GLM 5 Turbo\",\"description\":\"GLM-5 Turbo is a new model from Z.ai designed for fast inference and strong performance in agent-driven environments such as OpenClaw scenarios. It is deeply optimized for real-world agent workflows involving long execution chains, with improved complex instruction decomposition, tool use, scheduled and persistent execution, and overall stability across extended tasks.\",\"created_at\":\"2026-03-15T14:06:13.880Z\",\"context_length\":202752,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5-turbo\",\"model_variant_permaslug\":\"z-ai/glm-5-turbo-20260315\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"1.2e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"4e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.24e-6\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000012\",\"completion\":\"0.000004\",\"input_cache_read\":\"0.00000024\",\"discount\":0}}},{\"slug\":\"z-ai/glm-5\",\"permaslug\":\"z-ai/glm-5-20260211\",\"name\":\"Z.ai: GLM 5\",\"description\":\"GLM-5 is Z.ai’s flagship open-source foundation model engineered for complex systems design and long-horizon agent workflows. Built for expert developers, it delivers production-grade performance on large-scale programming tasks, rivaling leading closed-source models. With advanced agentic planning, deep backend reasoning, and iterative self-correction, GLM-5 moves beyond code generation to full-system construction and autonomous execution.\",\"created_at\":\"2026-02-11T16:59:42.000Z\",\"context_length\":204800,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-5\",\"model_variant_permaslug\":\"z-ai/glm-5-20260211\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000006\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00000192\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000012\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000006\",\"completion\":\"0.00000192\",\"input_cache_read\":\"0.00000012\",\"discount\":0.4}}},{\"slug\":\"z-ai/glm-4.7-flash\",\"permaslug\":\"z-ai/glm-4.7-flash-20260119\",\"name\":\"Z.ai: GLM 4.7 Flash\",\"description\":\"As a 30B-class SOTA model, GLM-4.7-Flash offers a new option that balances performance and efficiency. It is further optimized for agentic coding use cases, strengthening coding capabilities, long-horizon task planning, and tool collaboration, and has achieved leading performance among open-source models of the same size on several current public benchmark leaderboards.\",\"created_at\":\"2026-01-19T14:45:13.352Z\",\"context_length\":200000,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.7-flash\",\"model_variant_permaslug\":\"z-ai/glm-4.7-flash-20260119\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.00000006\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.0000004\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00000006\",\"completion\":\"0.0000004\",\"input_cache_read\":\"0.00000001\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.7\",\"permaslug\":\"z-ai/glm-4.7-20251222\",\"name\":\"Z.ai: GLM 4.7\",\"description\":\"GLM-4.7 is Z.ai’s latest flagship model, featuring upgrades in two key areas: enhanced programming capabilities and more stable multi-step reasoning/execution. It demonstrates significant improvements in executing complex agent tasks while delivering more natural conversational experiences and superior front-end aesthetics.\",\"created_at\":\"2025-12-22T04:33:34.884Z\",\"context_length\":204800,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.7\",\"model_variant_permaslug\":\"z-ai/glm-4.7-20251222\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000004\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00000175\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000008\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000004\",\"completion\":\"0.00000175\",\"input_cache_read\":\"0.00000008\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.6v\",\"permaslug\":\"z-ai/glm-4.6-20251208\",\"name\":\"Z.ai: GLM 4.6V\",\"description\":\"GLM-4.6V is a large multimodal model designed for high-fidelity visual understanding and long-context reasoning across images, documents, and mixed media. It supports up to 128K tokens, processes complex page layouts and charts directly as visual inputs, and integrates native multimodal function calling to connect perception with downstream tool execution. The model also enables interleaved image-text generation and UI reconstruction workflows, including screenshot-to-HTML synthesis and iterative visual editing.\",\"created_at\":\"2025-12-08T15:24:22.464Z\",\"context_length\":131072,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.6v\",\"model_variant_permaslug\":\"z-ai/glm-4.6-20251208\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000003\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.0000009\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.000000055\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000003\",\"completion\":\"0.0000009\",\"input_cache_read\":\"0.000000055\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.6\",\"permaslug\":\"z-ai/glm-4.6\",\"name\":\"Z.ai: GLM 4.6\",\"description\":\"Compared with GLM-4.5, this generation brings several key improvements:\\n\\nLonger context window: The context window has been expanded from 128K to 200K tokens, enabling the model to handle more complex agentic tasks.\\nSuperior coding performance: The model achieves higher scores on code benchmarks and demonstrates better real-world performance in applications such as Claude Code、Cline、Roo Code and Kilo Code, including improvements in generating visually polished front-end pages.\\nAdvanced reasoning: GLM-4.6 shows a clear improvement in reasoning performance and supports tool use during inference, leading to stronger overall capability.\\nMore capable agents: GLM-4.6 exhibits stronger performance in tool using and search-based agents, and integrates more effectively within agent frameworks.\\nRefined writing: Better aligns with human preferences in style and readability, and performs more naturally in role-playing scenarios.\",\"created_at\":\"2025-09-30T12:32:56.306Z\",\"context_length\":204800,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.6\",\"model_variant_permaslug\":\"z-ai/glm-4.6\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.00000043\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00000175\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000008\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00000043\",\"completion\":\"0.00000175\",\"input_cache_read\":\"0.00000008\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.5v\",\"permaslug\":\"z-ai/glm-4.5v\",\"name\":\"Z.ai: GLM 4.5V\",\"description\":\"GLM-4.5V is a vision-language foundation model for multimodal agent applications. Built on a Mixture-of-Experts (MoE) architecture with 106B parameters and 12B activated parameters, it achieves state-of-the-art results in video understanding, image Q\u0026A, OCR, and document parsing, with strong gains in front-end web coding, grounding, and spatial reasoning. It offers a hybrid inference mode: a \\\"thinking mode\\\" for deep reasoning and a \\\"non-thinking mode\\\" for fast responses. Reasoning behavior can be toggled via the `reasoning` `enabled` boolean. [Learn more in our docs](https://openrouter.ai/docs/use-cases/reasoning-tokens#enable-reasoning-with-default-config)\",\"created_at\":\"2025-08-11T14:24:48.340Z\",\"context_length\":65536,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.5v\",\"model_variant_permaslug\":\"z-ai/glm-4.5v\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000006\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.0000018\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.00000011\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000006\",\"completion\":\"0.0000018\",\"input_cache_read\":\"0.00000011\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.5\",\"permaslug\":\"z-ai/glm-4.5\",\"name\":\"Z.ai: GLM 4.5\",\"description\":\"GLM-4.5 is our latest flagship foundation model, purpose-built for agent-based applications. It leverages a Mixture-of-Experts (MoE) architecture and supports a context length of up to 128k tokens. GLM-4.5 delivers significantly enhanced capabilities in reasoning, code generation, and agent alignment. It supports a hybrid inference mode with two options, a \\\"thinking mode\\\" designed for complex reasoning and tool use, and a \\\"non-thinking mode\\\" optimized for instant responses. Users can control the reasoning behaviour with the `reasoning` `enabled` boolean. [Learn more in our docs](https://openrouter.ai/docs/use-cases/reasoning-tokens#enable-reasoning-with-default-config)\",\"created_at\":\"2025-07-25T19:22:27.278Z\",\"context_length\":131072,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.5\",\"model_variant_permaslug\":\"z-ai/glm-4.5\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"6e-7\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.0000022\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"1.1e-7\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000006\",\"completion\":\"0.0000022\",\"input_cache_read\":\"0.00000011\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4.5-air\",\"permaslug\":\"z-ai/glm-4.5-air\",\"name\":\"Z.ai: GLM 4.5 Air\",\"description\":\"GLM-4.5-Air is the lightweight variant of our latest flagship model family, also purpose-built for agent-centric applications. Like GLM-4.5, it adopts the Mixture-of-Experts (MoE) architecture but with a more compact parameter size. GLM-4.5-Air also supports hybrid inference modes, offering a \\\"thinking mode\\\" for advanced reasoning and tool use, and a \\\"non-thinking mode\\\" for real-time interaction. Users can control the reasoning behaviour with the `reasoning` `enabled` boolean. [Learn more in our docs](https://openrouter.ai/docs/use-cases/reasoning-tokens#enable-reasoning-with-default-config)\",\"created_at\":\"2025-07-25T19:20:58.066Z\",\"context_length\":131072,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"z-ai/glm-4.5-air\",\"model_variant_permaslug\":\"z-ai/glm-4.5-air\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.00000013\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00000085\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.000000025\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00000013\",\"completion\":\"0.00000085\",\"input_cache_read\":\"0.000000025\",\"discount\":0}}},{\"slug\":\"z-ai/glm-4-32b\",\"permaslug\":\"z-ai/glm-4-32b-0414\",\"name\":\"Z.ai: GLM 4 32B \",\"description\":\"GLM 4 32B is a cost-effective foundation language model.\\n\\nIt can efficiently perform complex tasks and has significantly enhanced capabilities in tool use, online search, and code-related intelligent tasks.\\n\\nIt is made by the same lab behind the thudm models.\",\"created_at\":\"2025-07-24T17:03:37.099Z\",\"context_length\":128000,\"output_modalities\":[\"text\"],\"endpoint\":null}]},\"dataUpdateCount\":1,\"dataUpdatedAt\":1791185734726,\"error\":null,\"errorUpdateCount\":0,\"errorUpdatedAt\":0,\"fetchFailureCount\":0,\"fetchFailureReason\":null,\"fetchMeta\":null,\"isInvalidated\":false,\"status\":\"success\",\"fetchStatus\":\"idle\"},\"queryKey\":[\"author-models\",\"detail\",{\"authorSlug\":\"z-ai\"}],\"queryHash\":\"[\\\"author-models\\\",\\\"detail\\\",{\\\"authorSlug\\\":\\\"z-ai\\\"}]\"}]},\"children\":\"$L88\"}]\n"])</script><script>self.__next_f.push([1,"89:I[556156,[\"/_next/static/immutable/chunks/1zet098htcd4i.js\",\"/_next/static/immutable/chunks/1ncwfr4wdrrub.js\",\"/_next/static/immutable/chunks/2xgvr_umi0kh_.js\",\"/_next/static/immutable/chunks/0fm-u2k-im7-i.js\",\"/_next/static/immutable/chunks/1m2s60egjx067.js\",\"/_next/static/immutable/chunks/1xgt1odsntw54.js\",\"/_next/static/immutable/chunks/2osv2vgv9ppxf.js\",\"/_nex