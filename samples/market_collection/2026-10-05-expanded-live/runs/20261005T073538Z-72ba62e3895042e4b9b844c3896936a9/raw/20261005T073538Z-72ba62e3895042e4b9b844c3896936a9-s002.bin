",\"/_next/static/immutable/chunks/3ui39chdx6c6x.js\",\"/_next/static/immutable/chunks/2ddt1_htigrdd.js\",\"/_next/static/immutable/chunks/26586yzglkebv.js\",\"/_next/static/immutable/chunks/0_e6m9d27fkzg.js\",\"/_next/static/immutable/chunks/2b5rclvkjaspp.js\",\"/_next/static/immutable/chunks/23q2j2v9yscsc.js\",\"/_next/static/immutable/chunks/0h970vx1kmz59.js\",\"/_next/static/immutable/chunks/2b_ifxqt7p7pj.js\",\"/_next/static/immutable/chunks/3vnq1t3eo4po1.js\",\"/_next/static/immutable/chunks/0gbzi12qx0v4k.js\",\"/_next/static/immutable/chunks/1umfhkwnaf1km.js\"],\"HydrationBoundary\"]\n82:[\"$\",\"$L87\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1791185740837,\"state\":{\"data\":{\"author\":{\"slug\":\"google\",\"name\":\"Google\"},\"models\":[{\"slug\":\"google/gemini-3.5-transcribe\",\"permaslug\":\"google/gemini-3.5-transcribe-20260827\",\"name\":\"Google: Gemini 3.5 Transcribe\",\"description\":\"Gemini 3.5 Transcribe is a speech-to-text model from Google. It is suited for synchronous transcription that needs word-level timestamps or speaker diarization, with support for up to eight speakers. Audio can be up to one hour, or 30 minutes when timestamps or diarization are enabled.\",\"created_at\":\"2026-09-25T00:23:40.067Z\",\"context_length\":98304,\"output_modalities\":[\"transcription\"],\"endpoint\":{\"model_variant_slug\":\"google/gemini-3.5-transcribe\",\"model_variant_permaslug\":\"google/gemini-3.5-transcribe-20260827\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000002\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000012\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.000002\",\"completion\":\"0.000012\",\"discount\":0}}},{\"slug\":\"google/gemini-3.8-flash-lite-tts\",\"permaslug\":\"google/gemini-3.8-flash-lite-tts-20260922\",\"name\":\"Google: Gemini 3.8 Flash Lite TTS\",\"description\":\"Gemini 3.8 Flash Lite TTS is a text-to-speech model from Google and the fast, high-throughput member of the 3.8 TTS family alongside [Gemini 3.8 Flash TTS](https://openrouter.ai/google/gemini-3.8-flash-tts). It is suited for conversational voice-agent pipelines, high-volume read-aloud, and voice replication workloads where latency and cost matter more than maximum expressiveness.\\n\\nIt accepts the same speech configuration as [Gemini 3.1 Flash TTS Preview](https://openrouter.ai/google/gemini-3.1-flash-tts-preview), including the 30 prebuilt studio voices, and supports Google's Voice Design and Voice Replication through `voice_...` identifiers.\",\"created_at\":\"2026-09-23T21:51:16.819Z\",\"context_length\":32768,\"output_modalities\":[\"speech\"],\"endpoint\":{\"model_variant_slug\":\"google/gemini-3.8-flash-lite-tts\",\"model_variant_permaslug\":\"google/gemini-3.8-flash-lite-tts-20260922\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000005\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M text tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000006\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M audio tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000005\",\"completion\":\"0.000006\",\"discount\":0}}},{\"slug\":\"google/gemini-3.8-flash-tts\",\"permaslug\":\"google/gemini-3.8-flash-tts-20260922\",\"name\":\"Google: Gemini 3.8 Flash TTS\",\"description\":\"Gemini 3.8 Flash TTS is a text-to-speech model from Google and the successor to [Gemini 3.1 Flash TTS Preview](https://openrouter.ai/google/gemini-3.1-flash-tts-preview). It is the creative tier of the 3.8 TTS family, suited for narration, character work, and multi-speaker dialogue where voice fidelity, acting nuance, and regional dialect coverage matter more than latency.\\n\\nIt accepts the same speech configuration as its predecessor, including the 30 prebuilt studio voices, and supports Google's Voice Design (custom voices from a text description) and Voice Replication (voices cloned from a short sample) through `voice_...` identifiers.\",\"created_at\":\"2026-09-23T21:51:06.674Z\",\"context_length\":32768,\"output_modalities\":[\"speech\"],\"endpoint\":{\"model_variant_slug\":\"google/gemini-3.8-flash-tts\",\"model_variant_permaslug\":\"google/gemini-3.8-flash-tts-20260922\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.0000005\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M text tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000009\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M audio tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.0000005\",\"completion\":\"0.000009\",\"discount\":0}}},{\"slug\":\"google/gemini-3.8-flash\",\"permaslug\":\"google/gemini-3.8-flash-20260902\",\"name\":\"Google: Gemini 3.8 Flash (batch)\",\"description\":\"Gemini 3.8 Flash is Google's most intelligent Flash model with significant gains from 3.7 Flash across software engineering, agentic tasks, and multi-step reasoning.\",\"created_at\":\"2026-09-02T15:14:16.246Z\",\"context_length\":1048576,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"google/gemini-3.8-flash:batch\",\"model_variant_permaslug\":\"google/gemini-3.8-flash-20260902:batch\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000000375\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000001875\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000000375\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Write\",\"price\":\"0.00000004166666666666667\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Image Input\",\"pr