 tokens\"}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.00001\",\"completion\":\"0.00005\",\"web_search\":\"0.01\",\"input_cache_read\":\"0.00000025\",\"input_cache_write\":\"0.0000125\",\"input_cache_write_1h\":\"0.00002\",\"discount\":0}}},{\"slug\":\"anthropic/claude-fable-5.1\",\"permaslug\":\"anthropic/claude-fable-5.1-20260831\",\"name\":\"Anthropic: Claude Fable 5.1 (batch)\",\"description\":\"Claude Fable 5.1 improves on Claude Fable 5 across the board, with the biggest gains in agentic coding, long-running agentic workflows, and knowledge work: long code refactors, front-end and visual code generation, and finance and analysis tasks in particular. It also tends to be more concise than Fable 5 in its plans and summaries. We recommend testing it as a direct upgrade wherever you use Fable 5 today, and alongside Opus 5 on reasoning-heavy tasks.\",\"created_at\":\"2026-09-01T18:03:58.014Z\",\"context_length\":1000000,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"anthropic/claude-fable-5.1:batch\",\"model_variant_permaslug\":\"anthropic/claude-fable-5.1-20260831:batch\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000005\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.000025\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.000000125\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Write\",\"price\":\"0.00000625\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Write (1h)\",\"price\":\"0.00001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"unit\",\"sku_label\":\"Web Search\",\"price\":\"0.01\",\"displayMultiplier\":1000,\"unitLabel\":\"/1K calls\",\"isServerTool\":true}],\"is_free\":false,\"pricing\":{\"prompt\":\"0.