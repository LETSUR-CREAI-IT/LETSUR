":"usage-and-diagnostics","LibraryCode":"modelark","ParentCode":"ark-cli-command-reference","Title":"Usage & Diagnostics","Index":15989667219456,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"tools-and-platform","next":"managed-agents"},"managed-agents":{"value":{"DocumentID":121372,"LibraryID":178,"ParentID":121365,"DocumentCode":"managed-agents","LibraryCode":"modelark","ParentCode":"ark-cli-command-reference","Title":"Managed Agents","Index":15989667288064,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"usage-and-diagnostics","next":"ark-document-skills"},"ai-suite-skills":{"value":{"DocumentID":121758,"LibraryID":178,"ParentID":121364,"DocumentCode":"ai-suite-skills","LibraryCode":"modelark","ParentCode":"ai-suite","Title":"Skills","Index":16017613342720,"Type":1,"Status":1,"SecondNav":{"ID":518,"Name":"AI Suite","Type":"custom","LibraryID":178,"DirStyle":"BoldExpand","Index":5,"Creator":"fumeng.fm@bytedance.com","Updater":"fumeng.fm@bytedance.com","PDFURL":"https:\u002F\u002Feps-common-private-johor.dualstack.ap-southeast-1.tos.bytepluses.com\u002Fcloud-doc\u002Feps-doc-center-pdf\u002FModelArk_AI%20Suite_1790687102.pdf","CreatedTime":"2026-09-24T14:21:25Z","UpdatedTime":"2026-09-29T13:05:03Z"}},"children":["ark-document-skills"]},"ark-document-skills":{"value":{"DocumentID":121753,"LibraryID":178,"ParentID":121758,"DocumentCode":"ark-document-skills","LibraryCode":"modelark","ParentCode":"ai-suite-skills","Title":"ModelArk documentation Skills","Index":16017670099968,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"managed-agents"}}}},"(lang)\u002Fdocs\u002F(libcode)\u002F(doccode$)\u002Fpage":{"lang":"id","docType":0,"apiType":"online","isContentDoc":false,"isPanelDoc":false,"curLibCode":"modelark","curDocCode":"model-pricing","curLib":null,"curDoc":{"DocumentID":121377,"DocumentCode":"model-pricing","LibraryID":178,"LibraryCode":"modelark","ParentID":110424,"ParentCode":"1399007","Title":"Pricing","EnTitle":"Pricing","Keywords":"ModelArk","Content":"{\"version\":\"0.4.24\",\"data\":{\"0\":{\"ops\":[{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vmthh11iav\",\"lmkr\":\"1\"}},{\"insert\":\"Features and unit prices vary with model services. This topic introduces the billing formulas and unit prices for each model to help you check and compare model prices.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vmvlo11jj0\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Tip\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vmxir11ka5\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"To learn about the billing method and detailed billing rules, see \"},{\"insert\":\"Model service billing\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F1544681\\\",\\\"linkId\\\":\\\"UprEsY3BCh\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#741ab123\",\"heading\":\"h1\",\"lineId\":\"vmz3p11lc4\",\"lmkr\":\"1\"}},{\"insert\":\"Large language models\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vn0di11m8b\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Note\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vn1w411nhn\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"The peak and off-peak hours for \"},{\"insert\":\"deepseek-v4-1-flash-260910\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\" are as follows:\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vn3sl11o6u\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Peak hours: (UTC+8) Monday to Friday, 09:00-12:00 and 14:00-18:00.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vn52c11pya\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Off-peak hours: All times other than the peak hours listed above are off-peak hours.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vn75r11qcr\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"The console displays the peak-hour price for \"},{\"insert\":\"deepseek-v4-1-flash-260910\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\". See the table below for complete pricing.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#aa1874cf\",\"heading\":\"h2\",\"lineId\":\"vn8gg11r5z\",\"lmkr\":\"1\"}},{\"insert\":\"Online inference (standard)\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rsmasfp0pu4o4af8kh0r9lr66tajfpl87g csntnnvphqs6njh2tbf17pfpak7rvugf8a\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnhhh11s98\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Pay-as-you-go by token. Calculation formula:\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnk4111txo\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Online inference cost = Input unit price × Input tokens + Cached input unit price × Cache hit tokens + Cache storage unit price × Cache storage tokens × Duration + Output unit price × Output tokens\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnman11u59\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Tiered billing: Applicable to some models. Token unit prices vary for different prompt lengths (and output lengths):\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnniw11vdy\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Example: A request with 200k input tokens and 14k output tokens falls in the range of \"},{\"insert\":\"prompt length (128, 256]\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\", so the model's input and output tokens are billed at: 0.25 USD per million tokens for input, 2 USD per million tokens for output.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#flex\",\"heading\":\"h2\",\"lineId\":\"vnosa11wgr\",\"lmkr\":\"1\"}},{\"insert\":\"Online inference (Flex)\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs46zp19dt9zouhlsvat1p1hj30kprwqgy cs46lzsnbilkcgy6dsrdermv1bgua5cuq8\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnrd711xty\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Input and output token prices for Online inference (Flex) are approximately 50% of the prices for online inference (standard). Cached input token prices are the same as those for online inference (standard).\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnswg11yi6\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Online inference (Flex) supports implicit caching only. No additional cache storage fee applies.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#f9bc1208\",\"heading\":\"h2\",\"lineId\":\"vnueq11z2a\",\"lmkr\":\"1\"}},{\"insert\":\"Batch inference\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rsi7fih0pfyu6561bynz6gatnfvbkf9h3q csh876f2otr4unce5fdp8m71o8ei2jgfgw\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnvn71208g\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Pay-as-you-go by token. Calculation formula: \"},{\"insert\":\"Batch inference cost = Input unit price × Input tokens + Cache hit unit price × Cache hit tokens + Output unit price × Output tokens\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnxrp121vh\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Some models support transparent prefix caching. For these models, no configuration is required, and you can enjoy lower unit prices after cache hits.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vnzb81224d\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"seed-1-6 series supports tiered pricing, that is, different token unit prices are adopted according to the input and output length of each request.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vo0sg123y6\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Example: A request with 200k input tokens and 14k output tokens falls in the range of \"},{\"insert\":\"prompt length (128, 256]\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\", so the model's input and output tokens are billed at: 0.25 USD per million tokens for input, 2 USD per million tokens for output.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#8f25f772\",\"heading\":\"h1\",\"lineId\":\"vo2oy1245u\",\"lmkr\":\"1\"}},{\"insert\":\"Video generation models\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vo3vz125sz\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Limited-time discount\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vo5es1266b\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Limited-time discounts are now available for Seedance 2.0 mini and Seedance 2.0 fast. The discounts apply only to enterprise users. Billing returns to the list price after the specified token usage cap is reached. For detailed rules, see \"},{\"insert\":\"Limited-time discount campaign rules for Seedance models\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F2630943\\\",\\\"linkId\\\":\\\"Rg2Hs1eLmx\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vo6oa127g5\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Seedance 2.0 mini\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\": From 14:00 (UTC+8) on August 7, 2026 through 14:00 (UTC+8) on October 7, 2026, both 480p and 720p output are billed at \"},{\"insert\":\"60% off the list price\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\". For 720p output, the price starts at approximately USD 0.03 per second.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vo8hn128mx\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Seedance 2.0 fast\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\": From 14:00 (UTC+8) on August 7, 2026 through 14:00 (UTC+8) on October 7, 2026, both 480p and 720p output are billed at \"},{\"insert\":\"25% off the list price\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\". For 720p output, the price starts at approximately USD 0.09 per second.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vob8t129jf\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"tip\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vocsh12av3\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"Video pricing is determined by both the \"},{\"insert\":\"token rate\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\" and \"},{\"insert\":\"token consumption\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\". Under otherwise identical conditions:\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"voezs12b6w\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"A video generated at a higher resolution costs more than one generated at a lower resolution.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vogt112ciz\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"A video generated with video input costs more than one generated without video input.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"voi4b12dm8\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"You can use the \"},{\"insert\":\"Seedance 2.0 Series Pricing Calculator\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fbytedance.larkoffice.com\u002Fshare\u002Fbase\u002Fform\u002FshrcnIHSU1yg0GtzCX4pyW3g3yb\\\",\\\"linkId\\\":\\\"qFNdPIrQMU\\\",\\\"newTab\\\":true,\\\"target\\\":\\\"_blank\\\"}\"}},{\"insert\":\" and \"},{\"insert\":\"Seedance 2.5 Series Pricing Calculator\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fbytedance.larkoffice.com\u002Fshare\u002Fbase\u002Fform\u002FshrcnIYBa28VajWRTpAPEwR4icf\\\",\\\"linkId\\\":\\\"hSkd2I7I8S\\\",\\\"newTab\\\":true,\\\"target\\\":\\\"_blank\\\"}\"}},{\"insert\":\" to estimate the cost of each video. For typical pricing scenarios, see the \"},{\"insert\":\"pricing examples\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F1544106#0c3cd17c\\\",\\\"linkId\\\":\\\"myru14c3UA\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\" below.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#28d5ad67\",\"heading\":\"h2\",\"lineId\":\"vok0712eg2\",\"lmkr\":\"1\"}},{\"insert\":\"Pricing\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rscnb9f0a5vvzo7b6fpdry3fpyz87yahi2 cspbob4fvlcvwkafuy705bi67memguhin7\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vol9h12fxn\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"You are only charged for successfully generated videos. No fee is charged if generation fails due to reasons such as content moderation.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vonx112gme\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Estimated video price: \"},{\"insert\":\"Token unit price × Token consumption\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"voprt12hqc\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Estimated token consumption = \"},{\"insert\":\"(Input video duration + Output video duration) × Output video width × Output video height × Output video frame rate \u002F 1024\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\". This calculation is an estimate. The actual token consumption is subject to the \"},{\"insert\":\"usage.completion_tokens\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\" parameter returned after the API call.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vos7c12if0\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Dreamina Seedance 2.5 Draft mode\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F2607688#2.5_draft_mode\\\",\\\"linkId\\\":\\\"qMy4Fgayzu\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\" includes two task steps. Each task is billed independently:\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vothv12j31\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Step 1: Generate a Draft video. This step is billed as a 480p video.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vovb512kkm\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Step 2: Generate the final video from the Draft video. This step is billed based on the target resolution:\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vowv612l7t\",\"list\":\"bullet3\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"The token rate is \"},{\"insert\":\"determined by whether Step 1 includes input video\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vozcj12m0d\",\"list\":\"bullet3\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"When calculating token consumption, \"},{\"insert\":\"the input video duration is calculated based on the input video in Step 1. The Draft video is not counted\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vp25212n10\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Seedance 1.5 Pro: \"},{\"insert\":\"Draft video token consumption = Estimated normal video token consumption × Conversion factor\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\". The conversion factor is 0.7 for silent videos and 0.6 for videos with audio.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#0c3cd17c\",\"heading\":\"h2\",\"lineId\":\"vp3zl12ojj\",\"lmkr\":\"1\"}},{\"insert\":\"Price examples\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vp5ve12pft\",\"lmkr\":\"1\"}},{\"insert\":\"The following are some estimated prices based on estimated token usage. You can get a general idea of video generation costs for different specifications.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vp7gh12qtn\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Minimum token consumption limits\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vp8nw12rr6\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"For the Seedance 2.0 series and Seedance 2.5 models, when the input includes video, minimum token consumption limits apply:\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vp9vj12sjs\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"If the estimated token consumption is less than the minimum token consumption, the video price is calculated based on the minimum token consumption.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vpb3d12tpl\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"The minimum token consumption is related to resolution, aspect ratio, and video output duration. You can check the \"},{\"insert\":\"Seedance 2.0 series minimum token consumption table (estimated)\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fbytedance.larkoffice.com\u002Fwiki\u002FH0fUwHPxtiHayOk6CVpcZzKqnHJ?table=tblnV1KjhYJO1