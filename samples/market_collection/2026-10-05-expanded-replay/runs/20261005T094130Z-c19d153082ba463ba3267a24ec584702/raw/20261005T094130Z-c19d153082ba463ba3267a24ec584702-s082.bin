\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rszl1ntqu69dsikyq0bnhpitw3h6e5aob9 cs1qsvskig9t2elqetu8b0vwdgaummu4f7\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vq049137x2\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Note\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vq2l7138jt\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Images that are not successfully output due to reasons such as content moderation are not billed.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vq4g5139jc\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"In Seedream 5.0 pro layer decomposition, layers returned by the same request may fall into different pixel tiers. Each layer is billed separately based on its actual pixel tier.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vq5pf13ayl\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"For Seedream 5.0 lite, Seedream 4.5, and Seedream 4.0, sequential image generation is billed based on the actual number of generated images.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#33538fff\",\"heading\":\"h1\",\"lineId\":\"vq78e13bh7\",\"lmkr\":\"1\"}},{\"insert\":\"3D generation models\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rsd7dnuwpw5q00070vmpzza8ur2ikrnvie csun7lntuwmsopfdoimrjmag8k6i9orqhp\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vq96b13c1t\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Billing is based on the number of successfully output 3D files.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#34ca905e\",\"heading\":\"h1\",\"lineId\":\"vqap113d1y\",\"lmkr\":\"1\"}},{\"insert\":\"Embedding vision models\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vqc7p13eok\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Input (including images) is converted into tokens for billing.\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vqemk13fie\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Pay-as-you-go pricing by token\\n\"},{\"insert\":\" \",\"attributes\":{\"language\":\"Plaintext\",\"type\":\"codeblock\",\"wrap\":\"true\",\"zoneId\":\"No4ZIOlTNR\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vqg8l13ga9\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Image tokens = (width px × height px)\u002F784. Maximum token consumption per image is 1312 tokens.\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs71b5ii68melzfrv4o5fgrivcwypiok06 cshph8y4kccqn184nt4nfeh8is0wgnuno7\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#a4bfac4b\",\"heading\":\"h1\",\"lineId\":\"vqhhi13hks\",\"lmkr\":\"1\"}},{\"insert\":\"Model unit\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqinx13i85\",\"lmkr\":\"1\"}},{\"insert\":\"Model units are billed based on the selected machine type and usage duration, and pricing is independent of the model itself. You can flexibly combine \"},{\"insert\":\"Postpaid (hourly)\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\" and \"},{\"insert\":\"Prepaid (monthly)\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\" billing options.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqki613jq5\",\"lmkr\":\"1\"}},{\"insert\":\"The platform also provides a \"},{\"insert\":\"Model Unit Calculator\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fendpoint\u002Fcreate\\\",\\\"linkId\\\":\\\"JLBBtrHaxY\\\",\\\"newTab\\\":true,\\\"target\\\":\\\"_blank\\\"}\"}},{\"insert\":\" (available on the order page after login) to help you estimate the required machine types and quantities. It is strongly recommended to perform stress testing with real business traffic to accurately determine the appropriate machine specifications and capacity.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqmnl13k3s\",\"lmkr\":\"1\"}},{\"insert\":\"For more information about how to choose a plan, see \"},{\"insert\":\"What are the differences between model units of different machine types? How to choose a machine type?\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F1359411#112a7e97\\\",\\\"linkId\\\":\\\"UxexBDjq1d\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqoth13lrk\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Tip\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqqz613mxr\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"tip\\\"}\"}},{\"insert\":\"This is a Beta capability only open to invited users. To use it, submit \"},{\"insert\":\"a test application ticket\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fconsole.byteplus.com\u002Fworkorder\u002Fcreate?step=2\\u0026SubProductID=P00001514\\\",\\\"linkId\\\":\\\"TkqVQVRzm6\\\",\\\"newTab\\\":true,\\\"target\\\":\\\"_blank\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs2go69kr26hb4jmdo3cipc3js1upkk66j cs06ktpfcqjgqdnwa0ws5oqroyk6qpcl7p\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#ma_billing\",\"heading\":\"h1\",\"lineId\":\"vqsjb13nmf\",\"lmkr\":\"1\"}},{\"insert\":\"Managed Agents\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vquc313oja\",\"lmkr\":\"1\"}},{\"insert\":\"Billing is calculated as the sum of three items: Tokens actually consumed during agent operation, agent runtime duration, and number of tool calls.\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs2doi34mf23cqkt1zck8sur5g8ogo0kw0 csh1v30jofgdyv5b5mn9ky7unq8c15sqcy\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vqvlq13pj8\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"Billing formula: \"},{\"insert\":\"Managed Agents fee = Model invocation fee + agent runtime fee + tool calling fee\",\"attributes\":{\"inlineCode\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#2a2a6acd\",\"heading\":\"h1\",\"lineId\":\"vqxf513q1n\",\"lmkr\":\"1\"}},{\"insert\":\"Rate limits\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vqzii13rn9\",\"lmkr\":\"1\"}},{\"insert\":\"The call limits for each model are requests per minute (RPM) and tokens per minute (TPM). You can go to the \"},{\"insert\":\"Model activation\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002FopenManagement\\\",\\\"linkId\\\":\\\"WXHDQv9LIs\\\",\\\"newTab\\\":true,\\\"target\\\":\\\"_blank\\\"}\"}},{\"insert\":\" page to view the limits of each account (along with all its sub-accounts).\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vr0ra13sfp\",\"lmkr\":\"1\"}},{\"insert\":\"To increase your limits, submit a request on the console.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#a05784b7\",\"heading\":\"h1\",\"lineId\":\"vr2ne13te2\",\"lmkr\":\"1\"}},{\"insert\":\"Service unavailability\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vr4rh13u2e\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"An account is considered in arrears when its balance becomes insufficient or falls below zero.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vr6wd13vye\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"If an account stays in arrears for 2 hours, the model services will be suspended. Services will resume once the account has been recharged. Please make sure that all outstanding bills are paid on time to avoid any unexpected service interruption.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#a0b6643a\",\"heading\":\"h1\",\"lineId\":\"vr91o13w43\",\"lmkr\":\"1\"}},{\"insert\":\"Coding Plan\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rskhpsd85ge7at0j910rzi0iwfz7488eq9 csq9kwrpp02n7d45bvd5kd7vsguy7c054g\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"blockquote\":\"true\",\"lineId\":\"vram513xbb\",\"lmkr\":\"1\",\"wrapperIndent\":\"0\"}},{\"insert\":\"For plan information and special offers, see \"},{\"insert\":\"Subscription overview\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F1925114\\\",\\\"linkId\\\":\\\"z3dnsRehFO\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\\n\"}],\"zoneId\":\"0\",\"zoneType\":\"Z\"},\"No4ZIOlTNR\":{\"ops\":[{\"insert\":\"*\",\"attributes\":{\"lineId\":\"vzd5o188tz\",\"lmkr\":\"1\"}},{\"insert\":\"Inference Cost = \\n    text input unit price × text token + \\n    image input unit price × image input token\\n\"}],\"zoneId\":\"No4ZIOlTNR\",\"zoneType\":\"Z\"},\"cs06ktpfcqjgqdnwa0ws5oqroyk6qpcl7p\":{\"ops\":[{\"insert\":{\"id\":\"c1h86og1vyb8cdp15lztgop955mz46g97b\"},\"attributes\":{\"backgroundColor\":\"{\\\"tsequh89\\\":\\\"\\\",\\\"4ly8ari2\\\":\\\"\\\",\\\"b2i7cp7t\\\":\\\"\\\"}\",\"colWidth\":\"100\",\"colWidthSpan\":\"1\",\"mergeCellID\":\"vhntrmzt,vhntrmzt,fsozj13s,fsozj13s\"}},{\"insert\":{\"id\":\"c1izjm4s5wner97g9ni3ucyf15ntn1eekq\"},\"attributes\":{\"backgroundColor\":\"{\\\"876804t7\\\":\\\"\\\",\\\"85zug