$\",\"h2\",null,{\"id\":\"model-explore-heading\",\"children\":\"Explore more models\",\"data-_gt\":\"$undefined\"}]\n7f:[\"$\",\"section\",null,{\"id\":\"documentation\",\"className\":\"scroll-mt-[calc(var(--navbar-height)+129px+var(--sticky-banner-top,0px))] lg:scroll-mt-[calc(var(--navbar-height)+70px+var(--sticky-banner-top,0px))] mb-10 last:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-4 gap-y-2 mb-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-book-open h-4 w-4 shrink-0 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1akyts\",{\"d\":\"M12 7v14\"}],[\"$\",\"path\",\"ruj8y\",{\"d\":\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-base font-medium\",\"children\":\"Documentation\"}],\"$undefined\"]}],null]}],[\"$\",\"p\",null,{\"className\":\"mb-4 max-w-2xl text-xs leading-relaxed text-muted-foreground\",\"children\":\"Guides, cookbooks, and tools for building with Anthropic: Claude Sonnet 5 on OpenRouter.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border border-none p-0\",\"children\":[\"$\",\"$L88\",null,{\"resources\":[{\"type\":\"cookbook\",\"title\":\"Claude 5 Sonnet Migration Guide\",\"href\":\"/docs/cookbook/evaluate-and-optimize/model-migrations/sonnet-5\"}],\"page\":\"model\"}]}]]}]\n8a:T965,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Claude Sonnet 5?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sonnet 5 is Anthropic's most capable Sonnet-class model, with frontier performance across coding, agents, and professional work. It supports adaptive thinking with selectable reasoning effort levels (low, medium, high, max, and x-high), a 1M-token context window, and text, image, and file inputs.\"}},{\"@type\":\"Question\",\"name\":\"Where is the Claude Sonnet 5 documentation?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Claude Sonnet 5 documentation on OpenRouter includes the Claude 5 Sonnet Migration Guide cookbook. The quickstart covers API keys and your first request, and the API reference lists every parameter.\"}},{\"@type\":\"Question\",\"name\":\"How much does Claude Sonnet 5 cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Claude Sonnet 5 costs $2.00/M input tokens and $10.00/M output tokens, with separate rates for Cache Read at $0.20/M tokens, Cache Write at $2.50/M tokens, Cache Write (1h) at $4.00/M tokens, and Web Search at $10.00/1K calls.\"}},{\"@type\":\"Question\",\"name\":\"What is the context length of Claude Sonnet 5?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Claude Sonnet 5 has a 1,000,000 token context window. It supports up to 128,000 completion tokens.\"}},{\"@type\":\"Question\",\"name\":\"Does Claude Sonnet 5 support tool calling and structured outputs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Claude Sonnet 5 accepts tools and tool_choice for function calling. It also supports structured outputs via a JSON schema in response_format.\"}},{\"@type\":\"Question\",\"name\":\"What inputs and outputs does Claude Sonnet 5 support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Claude Sonnet 5 accepts text, images, and files such as PDFs as input and returns text.\"}},{\"@type\":\"Question\",\"name\":\"Which providers serve Claude Sonnet 5?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Claude Sonnet 5 is served by 5 providers on OpenRouter: Claude Platform on AWS, Azure, Google Vertex, Amazon Bedrock, and Anthropic. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with provider routing.\"}},{\"@type\":\"Question\",\"name\":\"When was Claude Sonnet 5 released?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Claude Sonnet 5 was released on June 30, 2026.\"}}]}80:[[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"scroll-mt-[calc(var(--navbar-height)+129px+var(--sticky-banner-top,0px))] lg:scroll-mt-[calc(var(--navbar-height)+70px+var(--sticky-banner-top,0px))] mb-10 last:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-x-4 gap-y-2 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-4 w-4 shrink-0 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-base font-medium\",\"children\":\"Frequently asked questions\"}],\"$undefined\"]}],null]}],null,[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border border-none p-0\",\"children\":[\"$\",\"$L89\",null,{\"faqs\":[{\"question\":\"What is Claude Sonnet 5?\",\"answer\":\"Sonnet 5 is Anthropic's most capable Sonnet-class model, with frontier performance across coding, agents, and professional work. It supports adaptive thinking with selectable reasoning effort levels (low, medium, high, max, and x-high), a 1M-token context window, and text, image, and file inputs.\",\"isCustom\":false},{\"question\":\"Where is the Claude Sonnet 5 documentation?\",\"answer\":\"The Claude Sonnet 5 documentation on OpenRouter includes the [Claude 5 Sonnet Migration Guide](/docs/cookbook/evaluate-and-optimize/model-migrations/sonnet-5) cookbook. The [quickstart](/docs/quickstart) covers API keys and your first request, and the [API reference](/docs/api-reference/overview) lists every parameter.\",\"isCustom\":false},{\"question\":\"How much does Claude Sonnet 5 cost?\",\"answer\":\"Claude Sonnet 5 costs $2.00/M input tokens and $10.00/M output tokens, with separate rates for Cache Read at $0.20/M tokens, Cache Write at $2.50/M tokens, Cache Write (1h) at $4.00/M tokens, and Web Search at $10.00/1K calls.\",\"isCustom\":false},{\"question\":\"What is the context length of Claude Sonnet 5?\",\"answer\":\"Claude Sonnet 5 has a 1,000,000 token context window. It supports up to 128,000 completion tokens.\",\"isCustom\":false},{\"question\":\"Does Claude Sonnet 5 support tool calling and structured outputs?\",\"answer\":\"Yes. Claude Sonnet 5 accepts `tools` and `tool_choice` for function calling. It also supports structured outputs via a JSON schema in `response_format`.\",\"isCustom\":false},{\"question\":\"What inputs and outputs does Claude Sonnet 5 support?\",\"answer\":\"Claude Sonnet 5 accepts text, images, and files such as PDFs as input and returns text.\",\"isCustom\":false},{\"question\":\"Which providers serve Claude Sonnet 5?\",\"answer\":\"Claude Sonnet 5 is served by 5 providers on OpenRouter: Claude Platform on AWS, Azure, Google Vertex, Amazon Bedrock, and Anthropic. Requests are routed to the best available provider, with automatic failover to the others, and you can pin or exclude providers with [provider routing](/docs/features/provider-routing).\",\"isCustom\":false},{\"question\":\"When was Claude Sonnet 5 released?\",\"answer\":\"Claude Sonnet 5 was released on June 30, 2026.\",\"isCustom\":false}],\"modelPermaslug\":\"anthropic/claude-sonnet-5-20260630\",\"modelSlug\":\"anthropic/claude-sonnet-5\"}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$8a\"}}]]\n"])</script><script>self.__next_f.push([1,"85:[\"$\",\"$L77\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1791185756276,\"state\":{\"data\":{\"author\":{\"slug\":\"anthropic\",\"name\":\"Anthropic\"},\"models\":[{\"slug\":\"anthropic/claude-sonnet-5.5\",\"permaslug\":\"anthropic/claude-sonnet-5.5-20260928\",\"name\":\"Anthropic: Claude Sonnet 5.5\",\"description\":\"Claude Sonnet 5.5 is Anthropic's Sonnet-class model for well-scoped everyday work, succeeding Claude Sonnet 5 as a direct upgrade. It is especially strong at building features, fixing bugs, and producing polished documents, slides, and spreadsheets, and it writes and communicates more clearly than its predecessor.\\n\\nThinking is always on, so effort is the main lever for trading off depth, latency, and cost, and lower effort settings keep it responsive for everyday agentic loops.\",\"created_at\":\"2026-09-28T18:04:46.586Z\",\"context_length\":1000000,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"anthropic/claude-sonnet-5.5\",\"model_variant_permaslug\":\"anthropic/claude-sonnet-5.5-20260928\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000002\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000002\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Write\",\"price\":\"0.0000025\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\"},{\"kind\":\"token\",\"sku_label\":\"Cache Write (1h)\",\"price\":\"0.000004\",\"displayMultiplier\":100