      <td tabindex="-1"><code class="code">bedrock-mantle</code></td>
      <td tabindex="-1"><code class="code">anthropic.claude-haiku-4-5</code></td>
      <td tabindex="-1"><code class="code">https://bedrock-mantle.<span>{</span>region}.api.aws/anthropic/v1/messages</code></td>
