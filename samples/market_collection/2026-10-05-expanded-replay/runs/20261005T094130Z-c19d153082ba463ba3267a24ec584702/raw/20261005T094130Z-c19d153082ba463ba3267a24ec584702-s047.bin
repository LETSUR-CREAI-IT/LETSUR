      <th><b>Reserved</b></th>
     </tr>
    </thead>
     <tr>
      <td tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-yes.png" alt="Green circle with white checkmark icon." data-alt-text-source="generated" style="max-width:10px" height="10px" /></td>
