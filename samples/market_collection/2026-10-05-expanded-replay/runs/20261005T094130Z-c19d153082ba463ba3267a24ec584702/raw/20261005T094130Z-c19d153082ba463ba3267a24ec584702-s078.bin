e/text-to-image/api\",\"termsOfService\":\"https://fal.ai/legal/terms-of-service\",\"provider\":{\"@type\":\"Organization\",\"@id\":\"https://fal.ai/#organization\",\"name\":\"fal\",\"alternateName\":[\"fal.ai\",\"Fal\",\"fal-ai\"],\"legalName\":\"Features \u0026 Labels Inc.\",\"url\":\"https://fal.ai/\",\"description\":\"fal is the generative media inference platform: call 1,000+ image, video, audio and 3D models through one API, or deploy your own models on serverless GPUs.\",\"knowsAbout\":[\"Generative media\",\"AI inference\",\"Serverless GPUs\",\"Model deployment\",\"Image generation models\",\"Video generation models\",\"Audio generation models\"],\"logo\":\"https://fal.ai/apple-touch-icon.png\",\"image\":\"https://fal.ai/og-thumbnail.webp\",\"sameAs\":[\"https://discord.gg/fal-ai\",\"https://github.com/fal-ai\",\"https://www.reddit.com/r/fal/\",\"https://twitter.com/fal\",\"https://www.linkedin.com/company/features-and-labels/\",\"https://www.youtube.com/@Fal.AI.Official\",\"https://www.instagram.com/madeonfal\",\"https://www.tiktok.com/@madeonfal\"],\"email\":\"support@fal.ai\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"San Francisco\",\"addressRegion\":\"CA\",\"addressCountry\":\"USA\",\"postalCode\":\"94105\"}}}4a:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$6c\"}}],[\"$\",\"$L6d\",null,{}],[\"$\",\"$L6e\",null,{\"state\":{\"mutations\":[],\"queries\":[]},\"children\":[\"$\",\"$L6f\",null,{\"endpointId\":\"openai/gpt-image-2.5/flare/text-to-image\",\"model\":{\"id\":\"openai/gpt-image-2.5/flare/text-to-image\",\"modelId\":\"dag68ccregj0c4arse8g\",\"isFavorited\":false,\"title\":\"GPT Image 2.5 Flare Text to Image\",\"category\":\"text-to-image\",\"tags\":[\"realism\",\"typography\",\"stylized\"],\"shortDescription\":\"OpenAI's default image model for most applications. Fast, high-quality generation with natural lighting, rich textures, and support for complex layouts including transparent backgrounds.\",\"thumbnailUrl\":\"https://v3b.fal.media/files/b/0aa9a39a/1RpGwGDfDZbwC_QBhudJo.jpg\",\"modelUrl\":\"https://fal.run/openai/gpt-image-2.5/flare/text-to-image\",\"githubUrl\":\"\",\"licenseType\":\"commercial\",\"date\":\"2026-09-08T19:38:25.222Z\",\"group\":{\"key\":\"gpt-25\",\"label\":\"Text to Image Flare\"},\"pricingInfoOverride\":\"Text tokens (per 1M): **$5.00** input, **$1.25** cached, **$10.00** output.\\nImage tokens (per 1M): **$8.00** input, **$2.00** cached, **$30.00** output. Changing the **quality** parameter significantly affects cost; by default we use **high**. Adjust it to your preference.\\nSee the description at the bottom of this page for more details on how much canonical image sizes cost. Total cost is rounded up to the closest hundredth of a cent ($0.0001.)\",\"machineType\":null,\"examples\":[],\"authSkippable\":false,\"status\":\"public\",\"publishedAt\":\"2026-09-08T20:10:48.775Z\",\"deprecated\":false,\"resultComparison\":false,\"hidePricing\":false,\"removed\":false,\"modelLab\":\"OpenAI\",\"modelLabId\":\"d8m36bkregj5ka3lrdhg\",\"modelFamily\":\"GPT Image 2.5\",\"landingPageSlug\":\"gpt-image-2.5\",\"hostingType\":\"proxy\",\"kind\":\"inference\",\"trainingEndpoints\":[]},\"modelData\":{\"endpointId\":\"openai/gpt-image-2.5/flare/text-to-image\",\"model\":\"$4a:2:props:children:props:model\",\"appData\":{\"app_name\":\"gpt-image-2.5-flare\",\"app_user_id\":\"github|110602490\",\"app_user_nickname\":\"fal-ai\",\"auth_mode\":\"shared\",\"container_image\":null,\"machine_type\":\"\",\"application_id\":\"ae52e08c-6570-4faf-987a-b80214815a08\",\"keep_alive\":0,\"min_concurrency\":0,\"max_concurrency\":0,\"concurrency_buffer\":0,\"concurrency_buffer_perc\":0,\"scaling_delay_seconds\":0,\"max_multiplexing\":0,\"request_timeout\":null,\"startup_timeout\":null,\"valid_regions\":[],\"updated_at\":\"2026-10-03T17:38:05.358633Z\",\"environment_name\":\"main\",\"is_namespace_aliased\":true,\"metadata\":{\"openapi\":{\"components\":{\"schemas\":{\"GPTImage25TextToImageRequest\":{\"x-fal-order-properties\":[\"prompt\",\"image_size\",\"background\",\"quality\",\"num_images\",\"output_format\",\"output_compression\",\"sync_mode\"],\"properties\":{\"quality\":{\"default\":\"high\",\"title\":\"Quality\",\"type\":\"string\",\"description\":\"Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.\",\"ui\":{\"important\":true},\"enum\":[\"auto\",\"low\",\"medium\",\"high\",\"xhigh\",\"max\"]},\"image_size\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/ImageSize\"},{\"type\":\"string\",\"enum\":[\"square_hd\",\"square\",\"portrait_4_3\",\"portrait_16_9\",\"landscape_4_3\",\"landscape_16_9\",\"auto\"]}],\"description\":\"The size of the generated image. Supports preset names, explicit {width, height}, or 'auto' to let the model pick the best size. Concrete sizes must have both dimensions as multiples of 16, max edge 3840px, aspect ratio \u003c= 3:1, total pixels between 655,360 and 8,294,400.\",\"title\":\"Image Size\",\"default\":\"landscape_4_3\"},\"output_compression\":{\"anyOf\":[{\"type\":\"integer\",\"minimum\":0,\"maximum\":100},{\"type\":\"null\"}],\"description\":\"Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.\",\"title\":\"Output Compression\"},\"background\":{\"default\":\"auto\",\"type\":\"string\",\"description\":\"Background for the generated image\",\"title\":\"Background\",\"enum\":[\"auto\",\"transparent\",\"opaque\"]},\"output_format\":{\"default\":\"png\",\"type\":\"string\",\"description\":\"Output format for the images\",\"title\":\"Output Format\",\"enum\":[\"jpeg\",\"png\",\"webp\"]},\"prompt\":{\"minLength\":1,\"maxLength\":32000,\"type\":\"string\",\"examples\":[\"create a realistic image taken with iphone at these coordinates 41°43′32″N 49°56′49″W 15 April 1912\"],\"description\":\"The prompt for image generation\",\"title\":\"Prompt\"},\"sync_mode\":{\"type\":\"boolean\",\"description\":\"If `True`, the media will be returned as a data URI and the output data won't be available in the request history.\",\"title\":\"Sync Mode\",\"default\":false},\"num_images\":{\"maximum\":10,\"examples\":[1],\"type\":\"integer\",\"description\":\"Number of images to generate\",\"minimum\":1,\"title\":\"Number of Images\",\"default\":1}},\"type\":\"object\",\"required\":[\"prompt\"],\"description\":\"GPT Image 2.5 generation inputs, kept separate from GPT Image 2.\",\"title\":\"GPTImage25TextToImageRequest\"},\"ImageResponse\":{\"x-fal-order-properties\":[\"images\"],\"properties\":{\"images\":{\"examples\":[[{\"height\":1024,\"url\":\"https://v3b.fal.media/files/b/0a869129/EnWrO3XWjPE0nxBDpaQrj.png\",\"content_type\":\"image/png\",\"width\":1024,\"file_name\":\"EnWrO3XWjPE0nxBDpaQrj.png\"}]],\"type\":\"array\",\"description\":\"The generated images.\",\"items\":{\"$ref\":\"#/components/schemas/ImageFile\"},\"title\":\"Images\"}},\"type\":\"object\",\"required\":[\"images\"],\"title\":\"ImageResponse\"},\"HTTPValidationError\":{\"x-fal-order-properties\":[\"detail\"],\"properties\":{\"detail\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/ValidationError\"},\"title\":\"Detail\"}},\"type\":\"object\",\"title\":\"HTTPValidationError\"},\"ImageSize\":{\"x-fal-order-properties\":[\"width\",\"height\"],\"properties\":{\"height\":{\"exclusiveMinimum\":0,\"type\":\"integer\",\"description\":\"The height of the generated image.\",\"maximum\":14142,\"title\":\"Height\",\"default\":512},\"width\":{\"exclusiveMinimum\":0,\"type\":\"integer\",\"description\":\"The width of the generated image.\",\"maximum\":14142,\"title\":\"Width\",\"default\":512}},\"type\":\"object\",\"title\":\"ImageSize\"},\"ImageFile\":{\"x-fal-order-properties\":[\"url\",\"content_type\",\"file_name\",\"file_size\",\"width\",\"height\"],\"properties\":{\"height\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}],\"description\":\"The height of the ima