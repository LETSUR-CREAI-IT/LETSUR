4,\"_133\":134,\"_135\":375,\"_137\":376,\"_139\":377,\"_141\":-7,\"_142\":34},{\"_125\":366,\"_127\":366,\"_128\":268,\"_130\":269,\"_132\":367,\"_133\":134,\"_135\":368,\"_137\":369,\"_139\":370,\"_141\":-7,\"_142\":34},{\"_125\":358,\"_127\":358,\"_128\":359,\"_130\":360,\"_132\":134,\"_133\":361,\"_135\":362,\"_137\":363,\"_139\":364,\"_141\":-7,\"_142\":49},{\"_125\":353,\"_127\":353,\"_128\":354,\"_130\":354,\"_132\":-7,\"_133\":134,\"_135\":355,\"_137\":356,\"_139\":357,\"_141\":-7,\"_142\":49},{\"_125\":347,\"_127\":347,\"_128\":348,\"_130\":349,\"_132\":-7,\"_133\":134,\"_135\":350,\"_137\":351,\"_139\":352,\"_141\":-7,\"_142\":49},{\"_125\":342,\"_127\":342,\"_128\":343,\"_130\":343,\"_132\":-7,\"_133\":134,\"_135\":344,\"_137\":345,\"_139\":346,\"_141\":-7,\"_142\":49},{\"_125\":337,\"_127\":337,\"_128\":338,\"_130\":338,\"_132\":-7,\"_133\":134,\"_135\":339,\"_137\":340,\"_139\":341,\"_141\":-7,\"_142\":49},{\"_125\":331,\"_127\":331,\"_128\":332,\"_130\":333,\"_132\":-7,\"_133\":134,\"_135\":334,\"_137\":335,\"_139\":336,\"_141\":-7,\"_142\":49},{\"_125\":326,\"_127\":326,\"_128\":327,\"_130\":327,\"_132\":-7,\"_133\":134,\"_135\":328,\"_137\":329,\"_139\":330,\"_141\":-7,\"_142\":49},{\"_125\":320,\"_127\":320,\"_128\":321,\"_130\":322,\"_132\":-7,\"_133\":134,\"_135\":323,\"_137\":324,\"_139\":325,\"_141\":-7,\"_142\":49},{\"_125\":311,\"_127\":311,\"_128\":312,\"_130\":313,\"_132\":314,\"_133\":315,\"_135\":316,\"_137\":317,\"_139\":318,\"_141\":-7,\"_142\":49},{\"_125\":305,\"_127\":305,\"_128\":306,\"_130\":307,\"_132\":-7,\"_133\":134,\"_135\":308,\"_137\":309,\"_139\":310,\"_141\":-7,\"_142\":49},{\"_125\":300,\"_127\":300,\"_128\":301,\"_130\":301,\"_132\":-7,\"_133\":134,\"_135\":302,\"_137\":303,\"_139\":304,\"_141\":-7,\"_142\":49},{\"_125\":295,\"_127\":296,\"_128\":134,\"_130\":134,\"_132\":-7,\"_133\":134,\"_135\":297,\"_137\":298,\"_139\":299,\"_141\":-7,\"_142\":49},{\"_125\":291,\"_127\":291,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":292,\"_137\":293,\"_139\":294,\"_141\":-7,\"_142\":49},{\"_125\":284,\"_127\":284,\"_128\":285,\"_130\":285,\"_132\":286,\"_133\":287,\"_135\":288,\"_137\":289,\"_139\":290,\"_141\":-7,\"_142\":49},{\"_125\":279,\"_127\":279,\"_128\":280,\"_130\":280,\"_132\":-7,\"_133\":134,\"_135\":281,\"_137\":282,\"_139\":283,\"_141\":-7,\"_142\":49},{\"_125\":267,\"_127\":267,\"_128\":268,\"_130\":269,\"_132\":270,\"_133\":271,\"_135\":272,\"_137\":273,\"_139\":274,\"_141\":-7,\"_142\":49},{\"_125\":263,\"_127\":263,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":264,\"_137\":265,\"_139\":266,\"_141\":-7,\"_142\":49},{\"_125\":258,\"_127\":259,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":260,\"_137\":261,\"_139\":262,\"_141\":-7,\"_142\":49},{\"_125\":252,\"_127\":252,\"_128\":253,\"_130\":254,\"_132\":-7,\"_133\":134,\"_135\":255,\"_137\":256,\"_139\":257,\"_141\":-7,\"_142\":49},{\"_125\":246,\"_127\":246,\"_128\":247,\"_130\":248,\"_132\":-7,\"_133\":134,\"_135\":249,\"_137\":250,\"_139\":251,\"_141\":-7,\"_142\":49},{\"_125\":240,\"_127\":240,\"_128\":241,\"_130\":242,\"_132\":-7,\"_133\":134,\"_135\":243,\"_137\":244,\"_139\":245,\"_141\":-7,\"_142\":49},{\"_125\":234,\"_127\":234,\"_128\":235,\"_130\":236,\"_132\":-7,\"_133\":134,\"_135\":237,\"_137\":238,\"_139\":239,\"_141\":-7,\"_142\":49},{\"_125\":228,\"_127\":229,\"_128\":230,\"_130\":230,\"_132\":-7,\"_133\":134,\"_135\":231,\"_137\":232,\"_139\":233,\"_141\":-7,\"_142\":49},{\"_125\":222,\"_127\":222,\"_128\":223,\"_130\":224,\"_132\":-7,\"_133\":134,\"_135\":225,\"_137\":226,\"_139\":227,\"_141\":-7,\"_142\":49},{\"_125\":216,\"_127\":216,\"_128\":217,\"_130\":218,\"_132\":-7,\"_133\":134,\"_135\":219,\"_137\":220,\"_139\":221,\"_141\":-7,\"_142\":49},{\"_125\":205,\"_127\":205,\"_128\":206,\"_130\":207,\"_132\":208,\"_133\":209,\"_135\":210,\"_137\":211,\"_139\":212,\"_141\":-7,\"_142\":49},{\"_125\":199,\"_127\":200,\"_128\":201,\"_130\":201,\"_132\":-7,\"_133\":134,\"_135\":202,\"_137\":203,\"_139\":204,\"_141\":-7,\"_142\":49},{\"_125\":193,\"_127\":193,\"_128\":194,\"_130\":195,\"_132\":-7,\"_133\":134,\"_135\":196,\"_137\":197,\"_139\":198,\"_141\":-7,\"_142\":49},{\"_125\":189,\"_127\":185,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":190,\"_137\":191,\"_139\":192,\"_141\":-7,\"_142\":49},{\"_125\":185,\"_127\":185,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":186,\"_137\":187,\"_139\":188,\"_141\":-7,\"_142\":49},{\"_125\":180,\"_127\":180,\"_128\":181,\"_130\":181,\"_132\":-7,\"_133\":134,\"_135\":182,\"_137\":183,\"_139\":184,\"_141\":-7,\"_142\":49},{\"_125\":175,\"_127\":175,\"_128\":176,\"_130\":176,\"_132\":-7,\"_133\":134,\"_135\":177,\"_137\":178,\"_139\":179,\"_141\":-7,\"_142\":49},{\"_125\":170,\"_127\":170,\"_128\":171,\"_130\":171,\"_132\":-7,\"_133\":134,\"_135\":172,\"_137\":173,\"_139\":174,\"_141\":-7,\"_142\":49},{\"_125\":163,\"_127\":163,\"_128\":164,\"_130\":164,\"_132\":134,\"_133\":163,\"_135\":165,\"_137\":166,\"_139\":167,\"_141\":-7,\"_142\":49},{\"_125\":156,\"_127\":157,\"_128\":158,\"_130\":159,\"_132\":-7,\"_133\":134,\"_135\":160,\"_137\":161,\"_139\":162,\"_141\":-7,\"_142\":49},{\"_125\":149,\"_127\":150,\"_128\":151,\"_130\":152,\"_132\":-7,\"_133\":134,\"_135\":153,\"_137\":154,\"_139\":155,\"_141\":-7,\"_142\":49},{\"_125\":143,\"_127\":143,\"_128\":144,\"_130\":145,\"_132\":-7,\"_133\":134,\"_135\":146,\"_137\":147,\"_139\":148,\"_141\":-7,\"_142\":49},{\"_125\":126,\"_127\":126,\"_128\":129,\"_130\":131,\"_132\":-7,\"_133\":134,\"_135\":136,\"_137\":138,\"_139\":140,\"_141\":-7,\"_142\":49},\"publisherName\",\"Zai\",\"displayName\",\"iconLight\",\"\",\"iconDark\",\"\",\"description\",\"publisherUIKey\",\"\",\"publisherIds\",[],\"registries\",[],\"disabledModels\",{},\"publisherContent\",\"preview\",\"TypeSafeAI\",\"\",\"\",[],[],{},\"Theai-Inc\",\"Theai-Inc.\",\"\",\"\",[],[],{},\"TaylorGeospatial\",\"Taylor Geospatial\",\"\",\"\",[],[],{},\"StanfordMIMI\",\"\",[169,163],[168],{},\"azureml\",\"stanfordmimi\",\"Spectre\",\"\",[],[],{},\"SandboxAQ\",\"\",[],[],{},\"RezolveAI\",\"\",[],[],{},\"Project Asimov\",[],[],{},\"ProjectAsimov\",[],[],{},\"PriorLabs\",\"\",\"\",[],[],{},\"PreferredNetworks\",\"Preferred Networks, Inc.\",\"\",[],[],{},\"Pi Labs\",\"\",\"\",\"locstrings.PublisherDescriptions.pilabs\",\"pilabs\",[205,214,215,209],[213],{},\"azureml-pilabs-p\",\"pi labs\",\"PiLabs\",\"OncAI\",\"\",\"\",[],[],{},\"NTT Data Corporation\",\"\",\"\",[],[],{},\"Msrx Eai\",\"msrx-eai\",\"\",[],[],{},\"MotifTechnologies\",\"\",\"\",[],[],{},\"Moonshot AI\",\"\",\"\",[],[],{},\"MiniMax\",\"\",\"\",[],[],{},\"MINDAI\",\"\",\"\",[],[],{},\"MicrosoftResearchAfricaNairobi\",\"Microsoft Research Africa Nairobi\",[],[],{},\"Microsoft HLS AI Frontiers\",[],[],{},\"Institute for Protein Design\",\"\",\"\",\"locstrings.PublisherDescriptions.institute-for-protein-design\",\"institute-for-protein-design\",[267,276,277,278],[275],{},\"azureml-instprodes\",\"institute for protein design\",\"InstituteForProteinDesign\",\"instituteforproteindesign\",\"Insilico Medicine\",\"\",[],[],{},\"HistAI\",\"\",\"HistAI provider\",\"histai\",[287,284],[168],{},\"FoundryTestPublisher2\",[],[],{},\"FoundryLocalOnAzureLocalPublisher\",\"Foundry Local on Azure Local\",[],[],{},\"Fireworks\",\"\",[],[],{},\"EngineeringGroup\",\"\",\"\",[],[],{},\"Domyn\",\"\",\"\",\"locstrings.PublisherDescriptions.domyn\",\"domyn\",[315,311],[319],{},\"azureml-domyn\",\"CartesiaAI\",\"\",\"\",[],[],{},\"BriaAI\",\"\",[],[],{},\"BosonAI\",\"\",\"\",[],[],{},\"Alibaba\",\"\",[],[],{},\"Ai2\",\"\",[],[],{},\"a2z Radiology AI\",\"\",\"\",[],[],{},\"Van Dijk Lab\",\"\",[],[],{},\"Mims Harvard\",\"\",\"\",\"mimsharvard\",[358,365],[168],{},\"mims harvard\",\"UW Institute for Protein Design\",\"Leading research organization focused on accelerating breakthroughs in protein engineering and biomolecular science, leveraging advanced computational methods and AI-driven discovery to design novel proteins for medicine, sustainability, and technology.\",[],[],{},\"Inception\",\"\",\"\",\"Pioneers diffusion-based large language models (dLLMs) that generate text in parallel for ultra-low latency and efficiency, delivering breakthrough performance for code, text, and multimodal tasks in enterprise environments.\",[],[],{},\"Voyage AI\",\"\",\"\",\"Specializes in high-precision embedding and reranking models that power fast, multilingual search and retrieval for RAG applications, optimizing accuracy, latency, and cost for enterprise-scale AI solutions.\",\"voyageai\",[387,378,388],[386],{},\"azureml-voyage\",\"voyage ai\",\"VoyageAI\",\"Wanglab\",\"\",\"Medical AI research group behind MedSAM2, a foundation model unifying 2D and 3D segmentation for precision medicine.\",\"wanglab\",[389,392],[168],{},\"## Overview\\nWangLab’s MedSAM2 is a breakthrough medical image segmentation foundation model designed for precision medicine. Built on the Segment Anything Model (SAM) 2.1 architecture, it uniquely unifies 2D and 3D segmentation across volumetric scans and video data. By reducing manual annotation costs by over 85% while preserving high accuracy, MedSAM2 accelerates clinical and research workflows where precise segmentation is traditionally time-consuming.\\n\\n### Why WangLab on Azure\\n\\nDeploying MedSAM2 on Azure unlocks secure, compliant infrastructure for healthcare applications. Pair the model with GPU-accelerated inference, Responsible AI tooling, and seamless workflow integration to bring state-of-the-art segmentation to cardiology, oncology, and surgery at scale.\",\"Stability AI\",\"\",\"\",\"Specializes in open-source generative AI models for image and text generation, including Stable Diffusion.\",\"stabilityai\",[397,406,401],[405],{},\"azureml-stabilityai\",\"stability ai\",\"Sight Machine\",\"\",\"Offers AI-driven manufacturing analytics to improve operational efficiency and product quality.\",\"sightmachine\",[407,415],[414],{},\"azureml-sight-machine\",\"sight machine\",\"Bayer\",\"\",\"Leverages AI for advancements in healthcare and agriculture, focusing on research and development.\",\"bayer\",[416,419],[423],{},\"azureml-bayer\",\"Rockwell Automation\",\"Rockwell\",\"\",\"Develops AI-driven industrial automation solutions to optimize manufacturing processes and operations.\",\"rockwell\",[424,433],[432],{},\"azureml-rockwellautomation\",\"rockwell automation\",\"Saifr\",\"\",\"Offers AI tools for content compliance and risk management in regulated industries.\",\"saifr\",[434,437],[441,442,443],{},\"azureml-saifr\",\"azureml-saifr-ipp\",\"azureml-saifr-prod\",\"NTT Data\",\"NTT DATA\",\"Provides AI solutions across various industries, focusing on digital transformation and innovation.\",\"nttdata\",[444,452],[451],{},\"azureml-nttdata\",\"ntt data\",\"Bria\",\"Develops generative AI models for visual content creation, including images and videos.\",\"bria\",[453,455],[459],{},\"azureml-bria\",\"Paige\",\"Paige AI\",\"\",\"\",\"Specializes in AI-powered pathology solutions to enhance cancer diagnosis and treatment planning.\",\"paige\",[460,465],[168,469],{},\"azureml-paige\",\"SDAIA\",\"\",\"Saudi Data and AI Authority developing AI solutions to drive national digital transformation.\",\"sdaia\",[470,473],[168],{},\"Core42\",\"JAIS\",\"\",\"Provides multilingual language models tailored for Arabic and English, facilitating diverse linguistic applications.\",\"core42\",[477,481],[485],{},\"azureml-core42\",\"Nixtla\",\"\",\"\",\"Focuses on time-series forecasting models, offering tools like TimeGEN-1 for predictive analytics.\",\"nixtla\",[486,490],[494],{},\"azureml-nixtla\",\"Deci AI\",\"\",\"Specializes in optimizing deep learning models for faster inference and deployment efficiency.\",\"deci\",[495,502,503],[168],{},\"deci-ai\",\"deci ai\",\"AI21 Labs\",\"\",\"Develops advanced language models like Jurassic-2 for complex text generation and understanding tasks.\",\"ai21\",[504,512],[511],{},\"azureml-ai21\",\"ai21 labs\",\"Gretel\",\"\",\"Provides synthetic data generation tools to enhance privacy and augment datasets for machine learning.\",\"gretel\",[513,516],[520],{},\"azureml-gretel\",\"Snowflake\",\"\",\"Cloud-based data platform that integrates with AI models for enhanced data processing and analysis.\",\"snowflake\",[521,524],[168],{},\"Databricks\",\"\",\"Provides a unified data analytics platform integrating AI model development and deployment capabilities.\",\"databricks\",[528,531],[535],{},\"azureml-restricted\",\"Cohere\",\"\",\"\",\"Offers language models optimized for retrieval-augmented generation and enterprise applications.\",\"cohere\",[536,540],[545],{},\"## Overview\\nCohere Inc. is a Canadian‑founded generative‑AI company launched in 2019 by former Google Brain researchers. Built around large‑language‑model families such as Command R/R+, Command A, and high‑precision Rerank APIs, Cohere focuses on enterprise and regulated‑industry use cases—finance, healthcare, manufacturing, energy, and the public sector—rather than consumer chatbots. “Attention Is All You Need” transformer paper—continues to steer Cohere’s mission to deliver secure, domain‑tuned LLMs for real‑world business workflows.\\n\\n### Why Cohere on Azure\\n\\nDeploy Command or Rerank side‑by‑side with Azure AI Search, store embeddings in Azure Vector DBs, and enjoy unified billing plus data‑residency controls.\",\"azureml-cohere\",\"Nvidia\",\"NVIDIA\",\"\",\"\",\"Offers GPU-optimized models and tools for high-performance AI applications across various domains.\",\"nvidia\",[546,551,556],[556,557],{},\"## Overview\\nNVIDIA’s Nemotron family supplies open‑weight reasoning models tuned for agentic workflows. The lineup scales from Nemotron Nano (8 B) for edge devices to Nemotron Ultra (253 B)—currently the top open model on reasoning leaderboards—while keeping permissive licensing.\\n\\n### Why NVIDIA on Azure\\n\\nCombine Nemotron with Azure GPU SKUs, Triton inference, and ML ops tooling to build high‑throughput agents without commercial licensing hurdles.\",\"nvidia-ai\",\"azureml-nvidia\",\"Mistral AI\",\"Mistral\",\"\",\"French AI startup offering efficient and cost-effective language models, including Mistral 7B and Mixtral.\",\"mistral\",[558,568,559],[567],{},\"## Overview\\nMistral AI is a Paris‑based startup founded in April 2023 by former DeepMind and Meta researchers. In June 2024, it secured a €600 million Series B round that pushed its valuation to €6 billion, making it Europe’s highest‑valued generative‑AI company. The firm develops high‑performance, open‑weight LLMs such as Mistral 7B, Mixtral 8×22B, and the 123‑billion‑parameter flagship Mistral Large, which debuted through a strategic partnership with Microsoft Azure. Its sparse Mixture‑of‑Experts architecture and permissive licensing drive efficient inference and rapid adoption across both open‑source and enterprise communities.\\n\\n### Why Mistral on Azure\\n\\nGet European‑licensed open weights with Azure’s Content Safety, deterministic scaling, and pay‑as‑you‑go billing, ideal for regulated industries wanting transparent models.\",\"azureml-mistral\",\"mistral ai\",\"Meta\",\"\",\"Open-source models like Llama 2, built for versatile language tasks and research applications.\",\"meta\",[569,572],[577],{},\"## Overview\\nMeta AI—the research arm of Meta Platforms—created the Llama family of open‑weight large language models, first launched in February 2023. Today the lineup ranges from lightweight 7 B models to the 405 B‑parameter Llama 3.1, with the natively multimodal Llama 4 Scout and Maverick unveiled in April 2025, stretching context windows to 256 K tokens and rivaling proprietary front‑runners on reasoning benchmarks. An open, source‑available license has catalyzed a 10× surge in cloud usage through 2024, making Llama the most widely deployed open LLM for edge and enterprise workloads alike.\\n\\n### Why Meta on Azure\\n\\nRun open weights under your own subscription, integrate with Azure GPU fleets, and fine‑tune with proprietary data while staying inside your compliance boundary.\",\"azureml-meta\",\"Hugging Face\",\"\",\"Hosts a vast repository of open-source models and tools for natural language processing tasks.\",\"huggingface\",[578,581,585],[585],{},\"HuggingFace\",\"Black Forest Labs\",\"\",\"\",\"Research-driven company behind Flux, a family of open-weight diffusion models optimized for speed, fidelity, and controllability.\",[595,586],[594],{},\"## Overview\\nBlack Forest Labs (BFL) is a research-driven AI company focused on generative image models. Their flagship Flux family delivers state-of-the-art open-weight diffusion models optimized for speed, fidelity, and controllability. Flux models are designed for both creative workflows and enterprise-grade deployments, balancing cutting-edge research with permissive licensing.\\n\\n### Why Black Forest Labs on Azure\\n\\nRunning Flux on Azure lets you pair open-weight diffusion with enterprise infrastructure: scalable GPU SKUs, serverless deployment, and integrated observability. You get the freedom of open licensing combined with Azure’s compliance, RAI safeguards, and workflow integration—helping teams move from experimentation to production image generation without friction.\",\"azureml-blackforestlabs\",\"black forest labs\",\"DeepSeek\",\"\",\"Develops cost-effective large language models optimized for performance and efficiency.\",\"deepseek\",[596,599],[603],{},\"azureml-deepseek\",\"xAI\",\"\",\"\",\"Develops the Grok language models focused on reasoning, learning, and advancing reliable, high-performance AI systems.\",\"xai\",[604,608],[612],{},\"azureml-xai\",\"Microsoft\",\"Microsoft's AI Superintelligence team builds enterprise-class AI models spanning reasoning, coding, image, voice, and transcription.\",\"phi\",[613,626],[620,168,621,622,623,624,625],{},\"## Overview\\nThe latest **MAI models** are trained from scratch with zero distillation on enterprise-grade, commercially licensed data, providing a clean lineage that is deployable into production with confidence. The flagship **MAI-Thinking-1**, a 35B-parameter reasoning model with a 256K context window, showcases the ability to compete with frontier models on tough benchmarks like **SWE-Bench Pro** at a fraction of the size and cost. Alongside it sit fast, inference-efficient models for coding and a chart-topping image model that already ranks among the best for editing.\\n\\n### Why Microsoft Models on Foundry\\n\\nMAI models are coming to **Microsoft Foundry**, where they run with first-party managed compute, granular quota, and zero data egress. The real differentiator is **Microsoft Frontier Tuning**: using reinforcement-learning environments, you adapt MAI models to your own data and workflows within your compliance boundary, so the resulting model stays yours.\",\"azureml-msr\",\"azureml-routers\",\"azureml-phi-prod\",\"azureml-cogsvc\",\"azureml-msrmsft\",\"azureml-ai-frontiers-p\",\"microsoft\",\"Anthropic\",\"\",\"\",\"Anthropic is an AI research company that creates safe, reliable, interpretable, and steerable AI systems.\",\"anthropic\",[627,631],[636],{},\"## Overview\\nAnthropic is an AI safety and research company that creates reliable, interpretable, and steerable AI systems. Anthropic's flagship product is Claude, a frontier AI model trusted by leading enterprises and millions of users worldwide for complex tasks including coding, agents, financial analysis, research, and office tasks. Claude delivers exceptional performance while maintaining high safety standards.\\n\\n### Why Claude on Azure\\n\\nAnthropic's Claude models on Azure combine Claude's advanced reasoning and safety with seamless integration through Azure ecosystem.\",\"azureml-anthropic\",\"OpenAI\",\"Azure OpenAI\",\"\",\"Microsoft-hosted OpenAI models offering enterprise-grade security and compliance.\",\"aoai\",[637,681],[679,680],{\"_646\":647,\"_648\":649,\"_650\":651,\"_652\":653,\"_654\":655,\"_656\":657},\"## Overview\\nOpenAI aims to create \\\"safe and beneficial\\\" artificial general intelligence, defined as highly autonomous systems that outperform humans at most economically valuable work. The organization leads today's AI with some of the world's most advanced multimodal foundation models, including its frontier **gpt‑5.5** with a 1M‑token context window, and continues to compress state‑of‑the‑art performance into smaller, less expensive variants like **gpt‑5.4‑mini**. Newer speech models such as **gpt‑realtime‑1.5** handle low‑latency transcription and voice, while **gpt‑image‑2** brings native image generation and editing at up to 4K resolution.\\n\\n### Why OpenAI on Azure\\n\\nAll OpenAI endpoints inherit enterprise‑grade Content Safety, flexible serverless or provisioned‑throughput deployments, Azure billing, and private‑network inference so you can move from prototype to production in days, not months.\",\"o1-preview\",{\"_658\":676,\"_660\":677},\"computer-use-preview\",{\"_658\":673,\"_660\":674},\"o3\",{\"_658\":672,\"_660\":669},\"gpt-image-1\",{\"_658\":670,\"_660\":671},\"o3-pro\",{\"_658\":668,\"_660\":669},\"o3-deep-research\",{\"_658\":659,\"_660\":661},\"featureFlags\",[662,663,664,665,666,667],\"akaLink\",\"https://aka.ms/oai/deepresearchaccess\",\"OpenAI.EAGatingTier\",\"OpenAI.EnterpriseTier\",\"OpenAI.1PGatingTier\",\"OpenAITest\",\"OpenAI.OneVetGatingTier\",\"OpenAI.1000CUGatingTier\",[665,662,663,664,667,666],\"https://aka.ms/oai/o3access\",[662,663,664,667,666],\"https://aka.ms/oai/gptimage1access\",[662,663,664,667,666],[675],\"https://aka.ms/oai/cuaaccess\",\"OpenAI.computer-use-preview\",[678],\"https://aka.ms/oai/modelaccess\",\"OpenAI.Preview.202409\",\"azure-openai\",\"azureml-openai-oss\",\"openai\",{\"_35\":686,\"_37\":38,\"_39\":687,\"_41\":-5,\"_42\":43,\"_44\":43,\"_45\":43,\"_46\":-5,\"_47\":-5,\"_48\":49,\"_50\":51,\"_52\":53},[685,16],\"[\\\"model\\\",\\\"gpt-5.6-terra\\\"]\",\"mo