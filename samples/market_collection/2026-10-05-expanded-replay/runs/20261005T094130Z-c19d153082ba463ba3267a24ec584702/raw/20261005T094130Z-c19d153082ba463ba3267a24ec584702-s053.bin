":879},\"internal\",{},\"updateSequence\",66,\"type\",\"models\",\"2026-07-09\",\"entityContainerId\",\"entityObjectId\",\"resourceType\",\"relationships\",[],\"assetId\",\"azureml://registries/azure-openai/models/gpt-5.6-terra/versions/2026-07-09\",\"usage\",{\"_688\":43,\"_838\":839},\"isAFragment\",\"fragmentId\",\"popularity\",72.3,\"updatedTime\",\"0001-01-01T00:00:00+00:00\",\"creationContext\",{\"_883\":884,\"_885\":886,\"_887\":-5},\"id\",\"gpt-5.6-terra:2026-07-09\",\"name\",\"modelFramework\",\"Custom\",\"modelFrameworkVersion\",\"modelFormat\",\"CUSTOM\",\"alphanumericVersion\",\"url\",\"mimeType\",\"application/octet-stream\",\"modifiedTime\",\"2026-10-02T13:03:59.8009079+00:00\",\"unpack\",\"parentModelId\",\"runId\",\"experimentName\",\"derivedModelIds\",\"userProperties\",{\"_881\":16,\"_882\":826},\"isAnonymous\",\"orginAssetId\",\"intellectualProperty\",{\"_880\":-5},\"variantInfo\",\"weightType\",\"sourceData\",\"artifactProfile\",\"loraConfig\",\"systemManaged\",\"managedBy\",\"allowedDeploymentTemplates\",[],\"provisioningState\",\"Succeeded\",\"publisher\",\"AzureOpenAI-ModelName\",\"AzureOpenAI-Version\",\"createdTime\",\"2026-07-09T17:37:24.8227885+00:00\",\"createdBy\",{\"_888\":889,\"_890\":889,\"_891\":679,\"_892\":-5},\"creationSource\",\"userObjectId\",\"00000000-0000-0000-0000-000000000000\",\"userTenantId\",\"userName\",\"userPrincipalName\",\"invisibleUntil\",\"2026-07-09T17:00:00+00:00\",\"archived\",\"tags\",{\"_1015\":1016,\"_917\":918,\"_930\":1130,\"_937\":1120,\"_1131\":1132,\"_970\":637,\"_926\":1122,\"_963\":964,\"_932\":1133,\"_957\":958,\"_1017\":1134,\"_961\":962,\"_127\":929,\"_955\":1135,\"_1028\":1029,\"_981\":1132,\"_913\":1136,\"_1137\":1138,\"_928\":14,\"_959\":960,\"_935\":1139},\"datasets\",[],\"sampleInputData\",\"sampleOutputData\",\"resourceRequirements\",\"stage\",\"Development\",\"systemCatalogData\",{\"_880\":637,\"_913\":914,\"_915\":916,\"_917\":918,\"_919\":920,\"_921\":-5,\"_922\":-5,\"_923\":-5,\"_924\":-5,\"_925\":-5,\"_926\":927,\"_928\":14,\"_127\":929,\"_930\":931,\"_932\":933,\"_934\":-5,\"_935\":936,\"_937\":938,\"_939\":-5,\"_940\":-5,\"_941\":-5,\"_942\":-5,\"_943\":-5,\"_944\":-5,\"_945\":-5,\"_946\":-5,\"_947\":49,\"_948\":-5,\"_949\":-5,\"_950\":-5,\"_951\":-5,\"_142\":-5,\"_952\":-5,\"_953\":-5,\"_898\":-5,\"_954\":-5,\"_955\":956,\"_957\":958,\"_959\":960,\"_961\":962,\"_963\":964,\"_965\":-5,\"_966\":-5,\"_967\":-5,\"_968\":-5,\"_969\":-5,\"_970\":-5,\"_971\":-5,\"_972\":-5,\"_973\":-5,\"_974\":-5,\"_975\":-5,\"_976\":-5,\"_977\":-5,\"_978\":-5,\"_979\":-5,\"_980\":-5,\"_981\":34,\"_982\":-5,\"_983\":-5,\"_984\":-5,\"_985\":-5,\"_986\":-5,\"_658\":-5,\"_987\":-5,\"_988\":-5,\"_989\":-5,\"_990\":-5,\"_991\":-5,\"_992\":-5,\"_993\":-5,\"_994\":-5,\"_995\":-5,\"_996\":-5,\"_997\":-5,\"_998\":-5,\"_999\":-5,\"_1000\":-5,\"_1001\":-5,\"_1002\":1003,\"_1004\":1005,\"_1006\":1007,\"_1008\":-5,\"_1009\":-5,\"_1010\":-5,\"_1011\":-5,\"_1012\":-5,\"_1013\":-5,\"_1014\":-5,\"_1015\":1016,\"_1017\":1018,\"_1019\":1020,\"_1021\":-5,\"_1022\":1023,\"_1024\":1025,\"_1026\":38,\"_1027\":-5,\"_1028\":1029,\"_1030\":-5,\"_1031\":-5,\"_1032\":-5,\"_1033\":16,\"_1034\":826,\"_1035\":-5,\"_1036\":-5,\"_1037\":-5,\"_1038\":-5,\"_1039\":-5,\"_1040\":-5,\"_1041\":-5,\"_1042\":-5,\"_1043\":-5,\"_1044\":-5,\"_1045\":-5,\"_1046\":-5,\"_1047\":-5,\"_1048\":-5,\"_1049\":-5,\"_1050\":-5,\"_1051\":-5,\"_1052\":-5},\"# Direct from Azure models\\nDirect from Azure models are a select portfolio curated for their market-differentiated capabilities:\\n\\n- Secure and managed by Microsoft: Purchase and manage models directly through Azure with a single license, consistent support, and no third-party dependencies, backed by Azure's enterprise-grade infrastructure.\\n- Streamlined operations: Benefit from unified billing, governance, and seamless PTU portability across models hosted on Azure - all part of Microsoft Foundry.\\n- Future-ready flexibility: Access the latest models as they become available, and easily test, deploy, or switch between them within Microsoft Foundry; reducing integration effort.\\n- Cost control and optimization: Scale on demand with pay-as-you-go flexibility or reserve PTUs for predictable performance and savings.\\n\\nLearn more about [Direct from Azure models](https://aka.ms/DirectfromAzure).\\n\\n# Key capabilities\\n\\n## About this model\\n\\ngpt‑5.6‑terra is a balanced reasoning model in the GPT‑5.6 family that delivers strong reasoning and tool-use capabilities with lower cost and high scalability. Designed for everyday enterprise workloads, Terra provides an optimal balance of performance, efficiency, and cost while supporting up to a 1M‑token context window for large-scale business applications.\\n\\n## Key model capabilities\\n\\n- **Cost-Efficient Intelligence** – Delivers competitive performance at significantly lower cost, making it ideal for scaling AI workloads across the enterprise.\\n- **Balanced Reasoning** – Strong reasoning capabilities that improve as reasoning effort increases, enabling a flexible tradeoff between speed, cost, and depth of analysis.\\n- **Tool Use \u0026 Workflow Execution** – Effectively uses tools and external systems to complete real-world business workflows.\\n- **Long-Context Understanding** – Supports up to 1M tokens for processing large documents, knowledge bases, and multi-step workflows.\\n- **Enterprise Scale** – Optimized for high-volume deployments requiring reliable performance and cost efficiency.\\n- **Robust Safety Protections** – Safeguards calibrated to the model's capabilities to help detect and mitigate risk.\\n\\n\\n## Key use cases\\n\\ngpt‑5.6‑terra is best for scalable enterprise applications that require a balance of reasoning capability, cost efficiency, and throughput. It excels at business automation, knowledge retrieval, document analysis, workflow orchestration, agentic assistance, operational decision support, and other production workloads where organizations need strong performance at scale.\\n\\n## Out of scope use cases\\n\\nThe provider has not supplied this information.\\n\\n# Pricing\\nPricing is based on a number of factors, including deployment type and tokens used. [See pricing details here.](https://aka.ms/AzureOAIpricing)\\n\\n# Technical specs\\n\\nThe provider has not supplied this information.\\n\\n## Training cut-off date\\n\\n2026-06-17\\n\\n## Training time\\n\\nThe provider has not supplied this information.\\n\\n## Input formats\\n\\nThe provider has not supplied this information.\\n\\n## Output formats  \\n\\nThe provider has not supplied this information.\\n\\n## Supported languages\\n\\nThe provider has not supplied this information.\\n\\n## Sample JSON response\\n\\nThe provider has not supplied this information.\\n\\n## Model architecture\\n\\nThe provider has not supplied this information.\\n\\n## Long context\\n\\nThe provider has not supplied this information.\\n\\n## Optimizing model performance\\n\\nThe provider has not supplied this information.\\n\\n## Additional assets\\n\\nThe provider has not supplied this information.\\n\\n# Training disclosure\\n\\n## Training, testing and validation \\n\\nThe provider has not supplied this information.\\n\\n# Distribution\\n\\n## Distribution channels\\n\\nThis model is provided through the Azure OpenAI Service.\\n\\n# More information\\n\\nThe following documents are applicable:\\n\\n- [Overview of Responsible AI practices for Azure OpenAI models](https://learn.microsoft.com/legal/cognitive-services/openai/overview)\\n- [Transparency Note for Azure OpenAI Service](https://learn.microsoft.com/legal/cognitive-services/openai/transparency-note)\\n\\nOpenAI has incorporated additional safety measures including new techniques to help the models refuse unsafe requests. These advancements make the o1 series some of the most robust models available.\\n\\nOpenAI measures safety by testing how well models continue to follow its safety rules if a user tries to bypass them (known as \\\"jailbreaking\\\"). In OpenAI's internal tests, GPT-4o scored 22 (on a scale of 0-100) while o1-preview model scored 84. You can read more about this in the OpenAI's [system card](https://openai.com/index/openai-o1-system-card/) and [research post](https://openai.com/index/learning-to-reason-with-llms/).\\n\",\"labels\",[910,911,912],\"default\",\"latest\",\"invisibleLatest\",\"modelCapabilities\",[1126,1127,1128,1115,1129],\"deploymentTypes\",[1125],\"license\",\"custom\",\"inferenceTasks\",[1123,1124],\"fineTuningTasks\",\"fineTuningMethods\",\"inferenceComputeAllowed\",\"fineTuneComputeAllowed\",\"evaluationComputeAllowed\",\"languages\",[1122],\"summary\",\"OpenAI gpt-5.6-terra\",\"textContextWindow\",1050000,\"maxOutputTokens\",128000,\"maxInputTokens\",\"inputModalities\",[1120,1121],\"outputModalities\",[1120],\"playgroundRateLimitTier\",\"azureOffers\",\"inferenceRetirementDate\",\"finetuneDeprecationDate\",\"finetuneRetirementDate\",\"inferenceDeprecationDate\",\"inferenceLegacyDate\",\"longContextRetirementDate\",\"enableMaap\",\"enableBatch\",\"maasInference\",\"maasFineTuning\",\"featured\",\"previewType\",\"benchmark\",\"industry\",\"keywords\",[1117,1118,1119],\"licenseDescription\",\"Use of this Azure Direct Model is subject to applicable [Microsoft Product Terms](https://www.microsoft.com/licensing/terms/welcome/welcomepage) including the Universal License Terms for Microsoft Generative AI Services and the service-specific terms for Azure AI Foundry Models. If this Azure Direct Model is designated as Preview, its use is also subject to the [Supplemental Terms for Azure Previews](https://azure.microsoft.com/en-us/support/legal/preview-supplemental-terms/).\",\"trainingDataDate\",\"June 2026\",\"evaluation\",\"# Quality and performance evaluations\\nSource: OpenAI\\n\\nThe provider has not supplied this information.\\n\\n# Benchmarking methodology\\nSource: OpenAI\\n\\nThe provider has not supplied this information.\\n\\n# Public data summary\\nSource: OpenAI\\n\\nThe provider has not supplied this information.\",\"notes\",\"# Responsible AI considerations\\n\\nGPT-5.6-terra poses an elevated risk of producing explicit content, compared to previous versions of the model. We recommend that customers evaluate content filter settings on production systems before launching and conduct appropriate post-launch monitoring. All customers must comply with the Microsoft Enterprise AI Services Code of Conduct. Configuration options for content filtering vary when you deploy a model for production in Azure AI; [Learn more](https://learn.microsoft.com/en-us/azure/ai-foundry/concepts/foundry-models-overview?view=foundry-classic).\\n\\n## Safety techniques\\n\\nOpenAI has incorporated additional safety measures including new techniques to help the models refuse unsafe requests. These advancements make GPT-5.6-terra one of the most robust models available.\\n\\n## Safety evaluations\\n\\nOpenAI measures safety is by testing how well models continue to follow its safety rules if a user tries to bypass them (known as \\\"jailbreaking\\\").\\n\\n## Known limitations\\n\\nThe provider has not supplied this information.\\n\\n# Acceptable use\\n\\n## Acceptable use policy\\n\\nThe provider has not supplied this information.\",\"modelArchitecture\",\"componentVersion\",\"modelPath\",\"aotManifest\",\"hasDeltaWeights\",\"author\",\"baseModelWeightsVer\",\"evaluationMinSkuSpec\",\"evaluationRecommendedSkus\",\"finetuneMinSkuSpec\",\"finetuneRecommendedSkus\",\"inferenceMinSkuSpec\",\"inferenceRecommendedSkus\",\"sharedComputeCapacityEnabled\",\"freePlayground\",\"inferenceSupportedEnvs\",\"isDirectFromAzure\",\"inferenceEnvironmentAssetId\",\"maasFinetuningTest\",\"maasFinetuningDeployRegions\",\"maasFinetuningOffer\",\"maasFinetuningAvailableRegions\",\"architecture\",\"parameterCount\",\"terms\",\"softwareRequirements\",\"trademarkInformation\",\"contactInformation\",\"reportingMechanisms\",\"trainingApproa