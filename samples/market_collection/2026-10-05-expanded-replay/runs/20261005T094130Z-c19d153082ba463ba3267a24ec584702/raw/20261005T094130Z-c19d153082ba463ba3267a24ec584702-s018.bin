{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1791185749820,\"state\":{\"data\":{\"author\":{\"slug\":\"openai\",\"name\":\"OpenAI\"},\"models\":[{\"slug\":\"openai/gpt-6.1-sol-pro\",\"permaslug\":\"openai/gpt-6.1-sol-pro-20260929\",\"name\":\"OpenAI: GPT-6.1 Sol Pro\",\"description\":\"GPT-6.1 Sol Pro is the same underlying model as [GPT-6.1 Sol](https://openrouter.ai/openai/gpt-6.1-sol), served with `reasoning.mode` set to `pro` for higher-quality responses on complex tasks.\\n\\n**Cost note:** pro mode spends far more reasoning tokens per request, so a typical request costs several times more than the same request on GPT-6.1 Sol and takes much longer to complete. It is intended for hard, high-stakes problems where the extra accuracy justifies the cost. For everyday coding, agentic, and chat workloads, use [GPT-6.1 Sol](https://openrouter.ai/openai/gpt-6.1-sol) instead.\\n\\nLearn more in OpenAI's docs: https://developers.openai.com/api/docs/guides/reasoning#reasoning-mode\",\"created_at\":\"2026-09-29T17:28:06.435Z\",\"context_length\":1050000,\"output_modalities\":[\"text\"],\"endpoint\":{\"model_variant_slug\":\"openai/gpt-6.1-sol-pro\",\"model_variant_permaslug\":\"openai/gpt-6.1-sol-pro-20260929\",\"display_pricing\":[{\"kind\":\"token\",\"sku_label\":\"Input Price\",\"price\":\"0.000002\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\",\"tiers\":[{\"sku_label\":\"≤272K\",\"price\":\"0.000002\"},{\"sku_label\":\"\u003e272K\",\"price\":\"0.000004\"}]},{\"kind\":\"token\",\"sku_label\":\"Output Price\",\"price\":\"0.00001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\",\"tiers\":[{\"sku_label\":\"≤272K\",\"price\":\"0.00001\"},{\"sku_label\":\"\u003e272K\",\"price\":\"0.000015\"}]},{\"kind\":\"token\",\"sku_label\":\"Cache Read\",\"price\":\"0.0000001\",\"displayMultiplier\":1000000,\"unitLabel\":\"/M tokens\",\"tiers\":[{\"sku_label\":\"≤272K\",\"price\":\"0.0000001\"},{\"sku_label\":\"\u003e272K\",\"price\":\"0.0000002\"}]}