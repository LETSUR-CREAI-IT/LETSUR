-4"><div class="absolute transition-all duration-200 ease-in-out opacity-0 scale-50"><svg viewBox="0 0 16 16" height="16" width="16" data-slot="geist-icon" style="color:currentColor"><path fill="currentColor" fill-rule="evenodd" d="m15.56 4-.53.53-8.8 8.8c-.68.68-1.78.68-2.47 0l.53-.54-.53.53-2.79-2.79L.44 10 1.5 8.94l.53.53 2.8 2.8c.1.09.25.09.35 0l8.79-8.8.53-.53z" clip-rule="evenodd"></path></svg></div><div class="absolute transition-all duration-200 ease-in-out opacity-100 scale-100"><svg viewBox="0 0 16 16" height="16" width="16" data-slot="geist-icon" style="color:currentColor"><path fill="currentColor" fill-rule="evenodd" d="M8.25 2c.14 0 .25.11.25.25V3H10v-.75C10 1.28 9.22.5 8.25.5h-5.5C1.78.5 1 1.28 1 2.25v7.5c0 .97.78 1.75 1.75 1.75H4.5V10H2.75a.25.25 0 0 1-.25-.25v-7.5c0-.14.11-.25.25-.25zm5 4c.14 0 .25.11.25.25v7.5q-.02.23-.25.25h-5.5a.25.25 0 0 1-.25-.25v-7.5c0-.14.11-.25.25-.25zm0 9.5c.97 0 1.75-.78 1.75-1.75v-7.5c0-.97-.78-1.75-1.75-1.75h-5.5C6.78 4.5 6 5.28 6 6.25v7.5c0 .97.78 1.75 1.75 1.75z" clip-rule="evenodd"></path></svg></div></div></span></button></div></div><div data-section="content" class="border-gray-400 border-x rounded-b-lg [&amp;&gt;pre]:rounded-b-lg border-b"><pre class="prism-code language-ts vF3MAa_pre"><code class="font-mono grid text-left !text-[13px] leading-[20px] break-normal hyphens-none whitespace-pre text-[var(--ds-gray-1000)]" style="font-feature-settings:&quot;liga&quot; off" data-geist-code-block="true"><div class="line" data-geist-code-block-line="true" id="C2b1db0b1-L1" style="font-feature-settings:&quot;liga&quot; off"><button aria-hidden="true" tabindex="-1" type="button" aria-label="Add line anchor to the URL" class="vF3MAa_lineNumber">1</button><div class="token-line"><span class="token keyword">import</span><span class="token plain"> </span><span class="token punctuation">{</span><span class="token plain"> generateText </span><span class="token punctuation">}</span><span class="token plain"> </span><span class="toke