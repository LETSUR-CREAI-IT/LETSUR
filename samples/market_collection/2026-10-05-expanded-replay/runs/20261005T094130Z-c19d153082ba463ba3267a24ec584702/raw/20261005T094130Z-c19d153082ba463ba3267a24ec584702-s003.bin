ray-900\",\"children\":\"URL, base64, Uint8Array\"}],[\"$\",\"$L178\",null,{\"className\":\"text-gray-900\",\"children\":\"—\"}],[\"$\",\"$L178\",null,{\"className\":\"whitespace-nowrap text-gray-900\",\"children\":\"—\"}],[\"$\",\"$L178\",null,{\"className\":\"text-gray-900\",\"children\":\"Sent as file parts in messages; counts as input tokens\"}]]}]]}]]}]}],null]}]\n170:[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"Provider options\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Set AI Gateway routing options under \",[\"$\",\"code\",\"38:providerOptions.gateway\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"providerOptions.gateway\"}],\". For provider-specific options, pass them under the provider’s namespace as documented by the AI SDK.\"]}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Learn more in the\",\" \",[\"$\",\"$Lda\",null,{\"href\":\"https://ai-sdk.dev/providers/ai-sdk-providers/google\",\"className\":\"text-gray-1000 underline underline-offset-2\",\"children\":\"AI SDK google provider docs\"}],\".\"]}],[\"$\",\"$L16b\",null,{\"aria-label\":\"Provider options\",\"className\":\"w-full\",\"filename\":\"provider-options.ts\",\"language\":\"ts\",\"children\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    prompt: 'Why is the sky blue?',\\n    providerOptions: {\\n      gateway: {\\n        only: ['google', 'vertex'],\\n      },\\n    },\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}],[[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"These AI Gateway routing options apply to every model. Pro