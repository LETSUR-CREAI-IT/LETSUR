oviders remain available as fallbacks.\"]}]]}],[\"$\",\"$L175\",\"providerOptions.gateway.sort\",{\"children\":[[\"$\",\"$L178\",null,{\"children\":[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono text-gray-1000\",\"children\":\"providerOptions.gateway.sort\"}]}],[\"$\",\"$L178\",null,{\"children\":[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono whitespace-nowrap text-gray-900\",\"children\":\"'cost' | 'ttft' | 'tps'\"}]}],[\"$\",\"$L178\",null,{\"className\":\"text-gray-900\",\"children\":\"No\"}],[\"$\",\"$L178\",null,{\"className\":\"min-w-[20rem] whitespace-normal text-gray-900\",\"children\":[\"Rank candidate providers by price, time to first token, or tokens per second instead of the default routing order.\"]}]]}],[\"$\",\"$L175\",\"providerOptions.gateway.zeroDataRetention\",{\"children\":[[\"$\",\"$L178\",null,{\"children\":[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono text-gray-1000\",\"children\":\"providerOptions.gateway.zeroDataRetention\"}]}],[\"$\",\"$L178\",null,{\"children\":[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono whitespace-nowrap text-gray-900\",\"children\":\"boolean\"}]}],\"$L179\",\"$L17a\"]}]]}]]}]}]],\"$L17b\"]}]\n171:[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-10\",\"children\":[[\"$\",\"div\",\"Reasoning\",{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"Reasoning\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"AI Gateway bridges reasoning across every API format. The AI SDK exposes a provider-agnostic top-level \",[\"$\",\"code\",\"104:reasoning\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"reasoning\"}],\" level (\",[\"$\",\"code\",\"123:none\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"none\"}],\", \",[\"$\",\"code\",\"131:minimal\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"minimal\"}],\", \",[\"$\",\"code\",\"142:low\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"low\"}],\", \",[\"$\",\"code\",\"149:medium\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"medium\"}],\", \",[\"$\",\"code\",\"159:high\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"high\"}],\", or \",[\"$\",\"code\",\"170:xhigh\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"xhigh\"}],\"); the Chat Completions and Responses formats take the same effort under \",[\"$\",\"code\",\"250:reasoning.effort\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"reasoning.effort\"}],\"; and the Anthropic Messages format uses a native \",[\"$\",\"code\",\"318:thinking\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"thinking\"}],\" token budget. Whichever you send, the gateway maps it to the target model’s native configuration, converting between effort levels and token budgets as needed. Reasoning-related settings under \",[\"$\",\"code\",\"522:providerOptions\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"providerOptions\"}],\" take full precedence over the top-level \",[\"$\",\"code\",\"580:reasoning\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"reasoning\"}],\" value and are never merged. Reasoning tokens typically count toward your output-token usage, though how they’re reported and billed varies by provider.\"]}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Learn more in the\",\" \",[\"$\",\"$Lda\",null,{\"href\":\"/docs/ai-gateway/models-and-providers/reasoning\",\"className\":\"text-gray-1000 underline underline-offset-2\",\"children\":\"AI Gateway reasoning guide\"}],\".\"]}],[\"$\",\"$L16d\",null,{\"ariaLabel\":\"Reasoning\",\"variants\":[{\"label\":\"AI SDK v7\",\"example\":{\"filename\":\"reasoning.ts\",\"language\":\"ts\",\"code\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    prompt: 'Explain the Monty Hall problem step by step.',\\n    reasoning: 'high',\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}},{\"label\":\"Chat Completions\",\"example\":{\"filename\":\"reasoning-chat-completions.ts\",\"language\":\"ts\",\"code\":\"import OpenAI from 'openai';\\nimport 'dotenv/config';\\n\\nconst client = new OpenAI({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh/v1',\\n});\\n\\n// @ts-expect-error - reasoning is not yet in the OpenAI types\\nconst completion = await client.chat.completions.create({\\n  model: 'google/gemini-3.8-flash',\\n  messages: [{ role: 'user', content: 'Explain the Monty Hall problem step by step.' }],\\n  reasoning: { effort: 'high' },\\n});\\n\\nconsole.log(completion.choices[0].message.content);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$171:props:children:0:props:children:3:props:variants:1:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"reasoning_chat_completions.py\",\"language\":\"python\",\"code\":\"import os\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh/v1',\\n)\\n\\ncompletion = client.chat.completions.create(\\n    model='google/gemini-3.8-flash',\\n    messages=[{'role': 'user', 'content': 'Explain the Monty Hall problem step by step.'}],\\n    extra_body={'reasoning': {'effort': 'high'}},\\n)\\n\\nprint(completion.choices[0].message.content)\"}}]},{\"label\":\"Responses API\",\"example\":{\"filename\":\"reasoning-responses.ts\",\"language\":\"ts\",\"code\":\"import OpenAI from 'openai';\\nimport 'dotenv/config';\\n\\nconst client = new OpenAI({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh/v1',\\n});\\n\\nconst response = await client.responses.create({\\n  model: 'google/gemini-3.8-flash',\\n  input: 'Explain the Monty Hall problem step by step.',\\n  reasoning: { effort: 'high' },\\n  max_output_tokens: 2048,\\n});\\n\\nconsole.log(response.output_text);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$171:props:children:0:props:children:3:props:variants:2:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"reasoning_responses.py\",\"language\":\"python\",\"code\":\"import os\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh/v1',\\n)\\n\\nresponse = client.responses.create(\\n    model='google/gemini-3.8-flash',\\n    input='Explain the Monty Hall problem step by step.',\\n    reasoning={'effort': 'high'},\\n    max_output_tokens=2048,\\n)\\n\\nprint(response.output_text)\"}}]},{\"label\":\"Messages API\",\"example\":{\"filename\":\"reasoning-messages.ts\",\"language\":\"ts\",\"code\":\"import Anthropic from '@anthropic-ai/sdk';\\nimport 'dotenv/config';\\n\\nconst client = new Anthropic({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh',\\n});\\n\\nconst message = await client.messages.create({\\n  model: 'google/gemini-3.8-flash',\\n  max_tokens: 8192,\\n  thinking: { type: 'enabled', budget_tokens: 4096 },\\n  messages: [{ role: 'user', content: 'Explain the Monty Hall problem step by step.' }],\\n});\\n\\nconsole.log(message.content);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$171:props:children:0:props:children:3:props:variants:3:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"reasoning_messages.py\",\"language\":\"python\",\"code\":\"import os\\nimport anthropic\\n\\nclient = anthropic.Anthropic(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh',\\n)\\n\\nmessage = client.messages.create(\\n    model='google/gemini-3.8-flash',\\n    max_tokens=8192,\\n    thinking={'type': 'enabled', 'budget_tokens': 4096},\\n    messages=[{'role': 'user', 'content': 'Explain the Monty Hall problem step by step.'}],\\n)\\n\\nprint(message.content)\"}}]}]}]]}],\"$L17c\",\"$L17d\",\"$L17e\"]}]\n"])</script><script>self.__next_f.push([1,"179:[\"$\",\"$L178\",null,{\"className\":\"text-gray-900\",\"children\":\"No\"}]\n17a:[\"$\",\"$L178\",null,{\"className\":\"min-w-[20rem] whitespace-normal text-gray-900\",\"children\":[\"Route only to providers with a zero-data-retention policy for this model.\"]}]\n17b:[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"div\",\"Routing across providers\",{\"className\":\"flex flex-col gap-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-heading-16 font-medium text-gray-1000\",\"children\":\"Routing across providers\"}],[[\"$\",\"p\",\"AI Gateway serves the same model through multiple providers and fails over automatically. `order` expresses a preference while keeping every provider eligible; `only` is a hard allowlist — if none of the listed providers are available the request fails instead of falling back.\",{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"AI Gateway serves the same model through multiple providers and fails over automatically. \",[\"$\",\"code\",\"91:order\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"order\"}],\" expresses a preference while keeping every provider eligible; \",[\"$\",\"code\",\"161:only\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"only\"}],\" is a hard allowlist — if none of the listed providers are available the request fails instead of falling back.\"]}],[\"$\",\"p\",\"Options under a provider's own namespace (for example `providerOptions.anthropic`) are forwarded to that provider with the request. Providers ignore option namespaces that don't apply to them, so it is safe to set provider options alongside `gateway` routing options.\",{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Options under a provider's own namespace (for example \",[\"$\",\"code\",\"55:providerOptions.anthropic\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"providerOptions.anthropic\"}],\") are forwarded to that provider with the request. Providers ignore option namespaces that don't apply to them, so it is safe to set provider options alongside \",[\"$\",\"code\",\"242:gateway\",{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"gateway\"}],\" routing options.\"]}]]]}]]}]\n17c:[\"$\",\"div\",\"Image input\",{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"Image input\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Send images alongside text as message parts. Images count as input tokens.\"]}],null,[\"$\",\"$L16b\",null,{\"aria-label\":\"Image input\",\"className\":\"w-full\",\"filename\":\"image-input.ts\",\"language\":\"ts\",\"children\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    messages: [\\n      {\\n        role: 'user',\\n        content: [\\n          { type: 'text', text: 'Describe this image.' },\\n          { type: 'image', image: 'https://example.com/photo.jpg' },\\n        ],\\n      },\\n    ],\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}]]}]\n17d:[\"$\",\"div\",\"PDF input\",{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"PDF input\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Attach PDFs as file parts. Their contents count as input tokens.\"]}],null,[\"$\",\"$L16b\",null,{\"aria-label\":\"PDF input\",\"className\":\"w-full\",\"filename\":\"pdf-input.ts\",\"language\":\"ts\",\"children\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    messages: [\\n      {\\n        role: 'user',\\n        content: [\\n          { type: 'text', text: 'Summarize this document.' },\\n          {\\n            type: 'file',\\n            mediaType: 'application/pdf',\\n            data: 'https://example.com/document.pdf',\\n          },\\n        ],\\n      },\\n    ],\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}]]}]\n17e:[\"$\",\"div\",\"Tool calling\",{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"Tool calling\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"Expose tools the model can call. Define each tool’s inputs with a Zod schema.\"]}],null,[\"$\",\"$L16b\",null,{\"aria-label\":\"Tool calling\",\"className\":\"w-full\",\"filename\":\"tool-calling.ts\",\"language\":\"ts\",\"children\":\"import { generateText, tool } from 'ai';\\nimport { z } from 'zod';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    prompt: 'What is the weather in San Francisco?',\\n    tools: {\\n      getWeather: tool({\\n        description: 'Get the current weather for a location',\\n        inputSchema: z.object({ location: z.string() }),\\n        execute: async ({ location }) =\u003e ({ location, temperatureC: 18 }),\\n      }),\\n    },\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}]]}]\n"])</script><script type="application/json" data-flag-values="true">"eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..FuLlkhfIvOBHxuLN.r7n87sjO_vkMUQdwHMSWgH4GwKJcX9A1xfjy6lskC_z03j2MiwUCwQ.dSvqXzB8_jkHLM7JhJ3C0g"</script></body></html><script type="application/json" data-flag-values="true">"eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..FuLlkhfIvOBHxuLN.r7n87sjO_vkMUQdwHMSWgH4GwKJcX9A1xfjy6lskC_z03j2MiwUCwQ.dSvqXzB8_jkHLM7JhJ3C0g"</script>