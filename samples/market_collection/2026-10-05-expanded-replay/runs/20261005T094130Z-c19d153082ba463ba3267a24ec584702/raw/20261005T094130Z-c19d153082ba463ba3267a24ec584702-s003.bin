he AI SDK (\",[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"pnpm add ai dotenv\"}],\"), create an API key from the\",\" \",[\"$\",\"$Lda\",null,{\"href\":\"/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys\u0026title=AI+Gateway+API+Keys\",\"className\":\"text-gray-1000 underline underline-offset-2\",\"children\":\"API Keys page\"}],\", and set it as\",\" \",[\"$\",\"code\",null,{\"className\":\"text-copy-13-mono rounded bg-gray-100 px-1 py-0.5 text-gray-1000\",\"children\":\"AI_GATEWAY_API_KEY\"}],\" \",\"in your environment. Full setup is covered in the\",\" \",[\"$\",\"$Lda\",null,{\"href\":\"/docs/ai-gateway/getting-started/text\",\"className\":\"text-gray-1000 underline underline-offset-2\",\"children\":\"text generation quickstart\"}],\".\"]}],[\"$\",\"$L16b\",null,{\"aria-label\":\"Getting started with Gemini 3.8 Flash\",\"className\":\"w-full\",\"filename\":\"index.ts\",\"language\":\"ts\",\"children\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    prompt: 'Why is the sky blue?',\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-20 font-medium text-gray-1000\",\"children\":\"Top-level parameters\"}],[\"$\",\"p\",null,{\"className\":\"text-copy-14 max-w-3xl text-gray-900\",\"children\":[\"The same Gemini 3.8 Flash request in each API format AI Gateway supports.\"]}],null,[\"$\",\"$L16d\",null,{\"ariaLabel\":\"Top-level parameters\",\"variants\":[{\"label\":\"AI SDK v7\",\"example\":{\"filename\":\"top-level-params.ts\",\"language\":\"ts\",\"code\":\"import { generateText } from 'ai';\\nimport 'dotenv/config';\\n\\nasync function main() {\\n  const result = await generateText({\\n    model: 'google/gemini-3.8-flash',\\n    system: 'You are a concise technical assistant.',\\n    prompt: 'Summarize the tradeoffs between static generation and SSR.',\\n    maxOutputTokens: 1024,\\n  });\\n\\n  console.log(result.text);\\n}\\n\\nmain().catch(console.error);\"}},{\"label\":\"Chat Completions\",\"example\":{\"filename\":\"chat-completions.ts\",\"language\":\"ts\",\"code\":\"import OpenAI from 'openai';\\nimport 'dotenv/config';\\n\\nconst client = new OpenAI({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh/v1',\\n});\\n\\nconst completion = await client.chat.completions.create({\\n  model: 'google/gemini-3.8-flash',\\n  messages: [\\n    { role: 'system', content: 'You are a concise technical assistant.' },\\n    { role: 'user', content: 'Summarize the tradeoffs between static generation and SSR.' },\\n  ],\\n  max_tokens: 1024,\\n});\\n\\nconsole.log(completion.choices[0].message.content);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$16a:props:children:1:props:children:3:props:variants:1:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"chat_completions.py\",\"language\":\"python\",\"code\":\"import os\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh/v1',\\n)\\n\\nresponse = client.chat.completions.create(\\n    model='google/gemini-3.8-flash',\\n    messages=[\\n        {'role': 'system', 'content': 'You are a concise technical assistant.'},\\n        {'role': 'user', 'content': 'Summarize the tradeoffs between static generation and SSR.'},\\n    ],\\n    max_tokens=1024,\\n)\\n\\nprint(response.choices[0].message.content)\"}}]},{\"label\":\"Responses API\",\"example\":{\"filename\":\"responses.ts\",\"language\":\"ts\",\"code\":\"import OpenAI from 'openai';\\nimport 'dotenv/config';\\n\\nconst client = new OpenAI({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh/v1',\\n});\\n\\nconst response = await client.responses.create({\\n  model: 'google/gemini-3.8-flash',\\n  instructions: 'You are a concise technical assistant.',\\n  input: 'Summarize the tradeoffs between static generation and SSR.',\\n  max_output_tokens: 1024,\\n});\\n\\nconsole.log(response.output_text);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$16a:props:children:1:props:children:3:props:variants:2:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"responses.py\",\"language\":\"python\",\"code\":\"import os\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh/v1',\\n)\\n\\nresponse = client.responses.create(\\n    model='google/gemini-3.8-flash',\\n    instructions='You are a concise technical assistant.',\\n    input='Summarize the tradeoffs between static generation and SSR.',\\n    max_output_tokens=1024,\\n)\\n\\nprint(response.output_text)\"}}]},{\"label\":\"Messages API\",\"example\":{\"filename\":\"messages.ts\",\"language\":\"ts\",\"code\":\"import Anthropic from '@anthropic-ai/sdk';\\nimport 'dotenv/config';\\n\\nconst client = new Anthropic({\\n  apiKey: process.env.AI_GATEWAY_API_KEY,\\n  baseURL: 'https://ai-gateway.vercel.sh',\\n});\\n\\nconst message = await client.messages.create({\\n  model: 'google/gemini-3.8-flash',\\n  max_tokens: 1024,\\n  system: 'You are a concise technical assistant.',\\n  messages: [{ role: 'user', content: 'Summarize the tradeoffs between static generation and SSR.' }],\\n});\\n\\nconsole.log(message.content);\"},\"variants\":[{\"label\":\"TypeScript\",\"example\":\"$16a:props:children:1:props:children:3:props:variants:3:example\"},{\"label\":\"Python\",\"example\":{\"filename\":\"messages.py\",\"language\":\"python\",\"code\":\"import os\\nimport anthropic\\n\\nclient = anthropic.Anthropic(\\n    api_key=os.getenv('AI_GATEWAY_API_KEY'),\\n    base_url='https://ai-gateway.vercel.sh',\\n)\\n\\nmessage = client.messages.cr