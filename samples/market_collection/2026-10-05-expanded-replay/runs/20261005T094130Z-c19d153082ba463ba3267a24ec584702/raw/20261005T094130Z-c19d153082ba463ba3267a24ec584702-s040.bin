    </thead>
     <tr><td tabindex="-1"><code class="code">bedrock-runtime</code></td><td align="center" style="text-align: center;" tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-yes.png" alt="supported" style="max-width:10px" height="10px" /></td></tr>
     <tr><td tabindex="-1"><code class="code">bedrock-mantle</code></td><td align="center" style="text-align: center;" tabindex="-1"><img src="/images/bedrock/latest/userguide/images/icons/icon-yes.png" alt="supported" style="max-width:10px" height="10px" /></td></tr>
    </table></div></div>
