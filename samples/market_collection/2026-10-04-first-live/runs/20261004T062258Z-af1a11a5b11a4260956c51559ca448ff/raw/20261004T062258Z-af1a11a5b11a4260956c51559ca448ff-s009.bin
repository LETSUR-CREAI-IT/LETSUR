erit;padding:0"><code style="display:block;font-family:inherit;font-size:inherit;white-space:pre-wrap;line-height:inherit">import fal_client

result = fal_client.subscribe(
    &quot;bytedance/seedance-2.5/text-to-video&quot;,
    arguments={
        &quot;prompt&quot;: &quot;A spear-wielding warrior clashes with a dual-blade fighter in a maple leaf forest. Autumn leaves scatter on each impact. Slow dolly-in, late afternoon light.&quot;,
        &quot;duration&quot;: &quot;10&quot;,
        &quot;resolution&quot;: &quot;720p&quot;,
        &quot;aspect_ratio&quot;: &quot;16:9&quot;,
    }
)

print(result[&quot;video&quot;][&quot;url&quot;])</code></pre></div></div></pre>
