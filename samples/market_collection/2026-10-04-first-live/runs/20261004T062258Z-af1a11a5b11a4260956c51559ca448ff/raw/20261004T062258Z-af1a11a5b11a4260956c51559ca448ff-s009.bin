ctive:scale-[0.98] [&amp;&gt;svg]:stroke-[1.5] transition-[background-color,border-color,color,transform,opacity] duration-160 ease-out-quad border-transparent bg-transparent text-content-base [&amp;[data-state=open]:not([data-disabled])]:bg-surface-alpha disabled:border-transparent! disabled:bg-transparent! disabled:text-content-disabled! disabled:opacity-50 data-disabled:border-transparent data-disabled:bg-transparent data-disabled:text-content-disabled data-disabled:opacity-50 [&amp;:disabled&gt;svg]:text-content-disabled! [&amp;[data-disabled]&gt;svg]:text-content-disabled h-9 w-9 gap-0 [&amp;&gt;svg]:size-4 [&amp;&gt;svg]:text-current group/copy hover:bg-surface-alpha dark:hover:bg-surface-alpha" name="copyCode"><span class="pointer-events-none inline-grid size-4"><span class="transition-[opacity,filter,transform] duration-160 ease-out-quint [grid-area:1/1] scale-100 opacity-100 blur-none"><svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" color="currentColor" aria-hidden="true" role="img" class="size-full text-content-muted transition-colors duration-160 group-hover/copy:text-content-strong"><path stroke-linecap="square" d="M15 15v6H3V9h6m12 6H9V3h12z"></path></svg></span><span class="transition-[opacity,filter,transform] duration-160 ease-out-quint [grid-area:1/1] scale-[0.92] opacity-0 blur-xs"><svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" color="currentColor" aria-hidden="true" role="img" class="size-full text-success-900 dark:text-success-400"><path stroke-linecap="square" d="m5 14 4.2 4L19 7"></path></svg></span></span></button></div></div><div class="overflow-auto rounded-none px-2 py-1 font-mono leading-normal whitespace-pre-wrap bg-surface-alpha-light"><pre style="margin:0;font-family:inherit;font-size:inherit;line-height:inherit;white-space:pre-wrap;background:transparent;color:inherit;padding:0"><code style="display:block;font-family:inherit;font-size:inherit;white-space:pre-wrap;line-height:inherit">{
