"currentColor" stroke-width="3.6" stroke-linecap="round" stroke-dasharray="0 2"></path></svg></div></div><p class="line-clamp-3 font-hal text-landing-sm text-landing-ink">Editing built for the tightest control, edits scoped precisely to the instruction, with subject and composition preserved across many rounds of revision.</p><div class="mt-auto flex flex-wrap gap-1.5 pt-1"><span class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal text-2xs text-landing-ink">stylized</span><span class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal text-2xs text-landing-ink">transform</span><span class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal text-2xs text-landing-ink">editing</span></div></div></div></a></div></div></section><section id="flare-vs-sunburst" class="relative overflow-hidden border-t border-landing-border bg-white"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><div><img alt="" loading="lazy" width="443" height="671" decoding="async" data-nimg="1" class="absolute top-[25px] right-0 hidden min-[1600px]:block" style="color:transparent" srcSet="/landing/v2/_decor/blue/tiers-sticker.svg 1x, /landing/v2/_decor/blue/tiers-sticker.svg 2x" src="/landing/v2/_decor/blue/tiers-sticker.svg"/><img alt="" loading="lazy" width="45" height="557" decoding="async" data-nimg="1" class="absolute top-[348px] left-0 hidden mix-blend-multiply min-[1600px]:block" style="color:transparent" srcSet="/landing/v2/_decor/blue/tiers-text-unified.svg 1x, /landing/v2/_decor/blue/tiers-text-unified.svg 2x" src="/landing/v2/_decor/blue/tiers-text-unified.svg"/></div></div><div class="relative mx-auto w-full max-w-[1237px] px-3 py-[50px] min-[1320px]:px-0 md:px-8 md:py-24 xl:py-[138px]"><div class="flex flex-col gap-5 md:gap-10"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Two variants</span><h2 class="max-w-[824px] font-heading text-landing-h2-m font-medium text-landing-ink md:text-heading-5xl xl:text-landing-h2">Flare or Sunburst?</h2><p class="max-w-[723px] font-hal text-landing-sm text-landing-ink md:text-landing-body">Flare is the one to reach for by default. Move to Sunburst when the detail has to survive a close look. Everything else about the two is the same, including the price.</p></div><div class="mt-[30px] flex flex-col gap-6 md:mt-[73px]"><div class="overflow-x-auto"><div role="tablist" class="inline-flex w-max gap-1.5 rounded-xs border border-landing-border bg-white p-1 md:gap-2 md:p-[7px]"><button type="button" role="tab" aria-selected="true" class="rounded-xs px-2 py-1.5 font-heading text-landing-sm leading-[0.86] font-medium whitespace-nowrap md:px-3 md:py-2.5 md:text-landing-title md:leading-(--text-landing-title--line-height) focus-ring transition-colors duration-160 bg-landing-glow text-landing-ink">Flare</button><button type="button" role="tab" aria-selected="false" class="rounded-xs px-2 py-1.5 font-heading text-landing-sm leading-[0.86] font-medium whitespace-nowrap md:px-3 md:py-2.5 md:text-landing-title md:leading-(--text-landing-title--line-height) focus-ring transition-colors duration-160 bg-transparent text-landing-ink hover:bg-landing-surface">Sunburst</button><button type="button" role="tab" aria-selected="false" class="rounded-xs px-2 py-1.5 font-heading text-landing-sm leading-[0.86] font-medium whitespace-nowrap md:px-3 md:py-2.5 md:text-landing-title md:leading-(--text-landing-title--line-height) focus-ring transition-colors duration-160 bg-transparent text-landing-ink hover:bg-landing-surface">Compare</button></div></div><div class="flex flex-col"><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Best for</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Everyday generation and editing, the default choice</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Trade-off</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Higher quality than GPT Image 2 at 50% lower latency</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Editing behaviour</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Changes only what is asked, keeping subject, composition and background intact</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Text to image</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body"><code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">openai/gpt-image-2.5/flare/text-to-image</code></div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Editing</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body"><code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">openai/gpt-image-2.5/flare/edit</code></div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Max resolution</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">3840px on the long edge</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Quality levels</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">auto, low, medium, high, xhigh, max</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Transparent background</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Yes</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Reference images (edit)</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Up to 16</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Images per request</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Up to 4</div></div><div class="flex flex-col gap-2 border-b border-landing-border px-3 py-3 md:flex-row md:gap-[54px] min-h-[47px]"><div class="w-full shrink-0 font-hal text-landing-sm text-landing-accent md:w-[192px] md:text-landing-body">Pricing</div><div class="flex-1 font-hal text-landing-sm text-landing-ink md:text-landing-body">Identical to Sunburst at every size and quality</div></div></div></div></div></section><section id="whats-new" class="relative overflow-hidden border-t border-landing-border bg-landing-fill"><div class="relative mx-auto w-full max-w-[1237px] px-3 py-[50px] min-[1320px]:px-0 md:px-8 md:py-24 xl:py-[138px]"><div class="flex flex-col gap-5 md:gap-10"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">What&#x27;s new</span><h2 class="max-w-[824px] font-heading text-landing-h2-m font-medium text-landing-ink md:text-heading-5xl xl:text-landing-h2">What&#x27;s new in GPT Image 2.5</h2><p class="max-w-[723px] font-hal text-landing-sm text-landing-ink md:text-landing-body">The changes over GPT Image 2, as OpenAI described them at launch.</p></div><ul class="mt-[30px] grid grid-cols-1 gap-x-10 gap-y-8 md:mt-[60px] md:grid-cols-2 lg:grid-cols-3"><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Latency</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">Up to 50% faster than GPT Image 2</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70">OpenAI puts Flare at higher image quality than GPT Image 2 with 50% lower latency, which is what makes it the sensible default for high-volume and interactive work.</p></li><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Rendering</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">More natural light, richer texture</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70">Sharper detail across the frame, more convincing lighting, and more accurate rendering of images that carry real-world information.</p></li><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Style</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">Stronger style adherence</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70">A requested visual style holds more consistently from one generation to the next, so a set of images can share a look without hand-picking.</p></li><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">References</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">Subjects stay themselves</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70">Better preservation of the subject in a reference photo, including as it moves between styles, with up to 16 references per edit request.</p></li><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Editing</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">Edits that carry across turns</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70">Instructions are followed more reliably over multiple rounds, and earlier edits are more likely to survive later ones, even on complex subjects and backgrounds.</p></li><li class="flex flex-col items-start"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Output</span><h3 class="mt-4 font-heading text-landing-title font-medium text-landing-ink">Two more quality levels</h3><p class="mt-2 font-hal text-landing-body-m text-landing-ink/70"><code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">quality</code> now reaches<!-- --> <code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">xhigh</code> and <code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">max</code> above the old <code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">high</code> ceiling, alongside better handling of complex layouts and transparent backgrounds.</p></li></ul><p class="mt-10 max-w-[760px] font-hal text-landing-sm text-landing-ink/60">Latency, rendering, style, reference and editing claims are OpenAI&#x27;s own, published with the model on September 8, 2026. The quality levels are read from the endpoint schemas on fal.</p></div></section><section class="relative overflow-hidden border-t border-landing-border bg-white"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><div><img alt="" loading="lazy" width="202" height="592" decoding="async" data-nimg="1" class="absolute top-0 left-0 hidden min-[1650px]:block" style="color:transparent" srcSet="/landing/v2/_decor/blue/capabilities-cluster-left.svg 1x, /landing/v2/_decor/blue/capabilities-cluster-left.svg 2x" src="/landing/v2/_decor/blue/capabilities-cluster-left.svg"/><img alt="" loading="lazy" width="235" height="338" decoding="async" data-nimg="1" class="absolute top-[49px] right-0 hidden min-[1650px]:block" style="color:transparent" srcSet="/landing/v2/_decor/blue/capabilities-cluster-right.svg 1x, /landing/v2/_decor/blue/capabilities-cluster-right.svg 2x" src="/landing/v2/_decor/blue/capabilities-cluster-right.svg"/></div></div><div class="relative mx-auto w-full max-w-[1237px] px-3 py-[50px] min-[1320px]:px-0 md:px-8 md:py-24 xl:py-[138px]"><div class="flex flex-col gap-5 md:gap-10"><h2 class="max-w-[824px] font-heading text-landing-h2-m font-medium text-landing-ink md:text-heading-5xl xl:text-landing-h2">What you can make with GPT Image 2.5</h2></div><div class="mt-[30px] flex flex-col gap-20 md:mt-[73px] xl:gap-[136px]"><div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-[68px]"><div class="relative w-full rounded-sm border border-landing-border bg-landing-surface overflow-hidden" style="aspect-ratio:4 / 3"><img alt="AI-generated transit map poster for a fictional city with six colour-coded lines, legible station names, a keyed legend and a scale bar" data-state="closed" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent;-webkit-touch-callout:none" sizes="(min-width: 768px) 619px, 100vw" srcSet="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-640,q-80/info-transit.webp 640w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-768,q-80/info-transit.webp 768w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-896,q-80/info-transit.webp 896w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-1080,q-80/info-transit.webp 1080w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-1280,q-80/info-transit.webp 1280w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-1920,q-80/info-transit.webp 1920w" src="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Finfo-transit.png/tr:w-1920,q-80/info-transit.webp"/></div><div class="flex flex-col items-start gap-5 xl:gap-[30px]"><span class="inline-flex w-fit items-center border rounded-xs bg-landing-accent-soft px-[5px] py-[2px] md:px-[11px] md:py-[3px] border-landing-border text-landing-ink font-hal text-landing-sm md:text-landing-body">Information design</span><h3 class="max-w-[550px] font-heading text-landing-h3-m font-medium text-landing-ink md:text-heading-3xl xl:text-landing-h3">Dense layouts that stay readable</h3><p class="max-w-[505px] font-hal text-landing-sm text-landing-ink md:text-landing-body">GPT Image 2.5 holds a whole page of structured information in one pass. Six colour-coded routes, every station named, interchange markers, a keyed legend, a compass and a scale bar all stay legible and stay in register. Keeping a layout coherent while the type stays small is the part that usually breaks.</p></div></div><div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-[68px] md:[&amp;&gt;*:first-child]:order-2"><div class="relative w-full rounded-sm border border-landing-border bg-landing-surface overflow-hidden" style="aspect-ratio:4 / 3"><img alt="AI-generated extreme macro photograph of the sawn end of an oak log, with decades of growth rings, radial cracks and sap at the bark edge" data-state="closed" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent;-webkit-touch-callout:none" sizes="(min-width: 768px) 619px, 100vw" srcSet="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-640,q-80/cap-detail-rings.webp 640w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-768,q-80/cap-detail-rings.webp 768w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-896,q-80/cap-detail-rings.webp 896w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-1080,q-80/cap-detail-rings.webp 1080w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-1280,q-80/cap-detail-rings.webp 1280w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-1920,q-80/cap-detail-rings.webp 1920w" src="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-detail-rings.jpg/tr:w-1920,q-80/cap-detail-rings.webp"/></div><div class="flex flex-col items-start gap-5 xl:gap-[30px]"><span class="inline-flex w-fit items-center border rounded-xs bg-landing-accent-soft px-[5px] py-[2px] md:px-[11px] md:py-[3px] border-landing-border text-landing-ink font-hal text-landing-sm md:text-landing-body">Fine detail</span><h3 class="max-w-[550px] font-heading text-landing-h3-m font-medium text-landing-ink md:text-heading-3xl xl:text-landing-h3">Sharp enough to look at closely</h3><p class="max-w-[505px] font-hal text-landing-sm text-landing-ink md:text-landing-body">Sunburst is the variant to reach for when the image will be viewed large. Below, generated at 3072px on xhigh: decades of growth rings stay separate all the way in to an off-centre pith, widening on the side the tree leaned, with radial checks, chainsaw scoring and beads of sap at the bark edge. That is the kind of detail that lets a frame be enlarged or cropped into instead of reshot.</p></div></div><div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-[68px]"><div class="relative w-full rounded-sm border border-landing-border bg-landing-surface overflow-hidden" style="aspect-ratio:4 / 3"><img alt="AI-edited interior photograph after three successive edits, with the furniture and layout unchanged" data-state="closed" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent;-webkit-touch-callout:none" sizes="(min-width: 768px) 619px, 100vw" srcSet="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-640,q-80/edit-3.webp 640w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-768,q-80/edit-3.webp 768w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-896,q-80/edit-3.webp 896w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-1080,q-80/edit-3.webp 1080w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-1280,q-80/edit-3.webp 1280w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-1920,q-80/edit-3.webp 1920w" src="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-3.jpg/tr:w-1920,q-80/edit-3.webp"/></div><div class="flex flex-col items-start gap-5 xl:gap-[30px]"><span class="inline-flex w-fit items-center border rounded-xs bg-landing-accent-soft px-[5px] py-[2px] md:px-[11px] md:py-[3px] border-landing-border text-landing-ink font-hal text-landing-sm md:text-landing-body">Editing</span><h3 class="max-w-[550px] font-heading text-landing-h3-m font-medium text-landing-ink md:text-heading-3xl xl:text-landing-h3">Edits that change one thing</h3><p class="max-w-[505px] font-hal text-landing-sm text-landing-ink md:text-landing-body">Point the edit endpoints at up to 16 reference images and describe the change. Successive rounds keep the scene intact: across the three passes below, the furniture, the rug and the framing hold while the upholstery, the artwork and the time of day each change in turn. A mask is optional when the change needs to be confined to a region.</p></div></div><div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-[68px] md:[&amp;&gt;*:first-child]:order-2"><div class="relative w-full rounded-sm border border-landing-border bg-landing-surface overflow-hidden" style="aspect-ratio:4 / 3"><img alt="AI-generated running shoe product cutout on a transparent background in landscape framing" data-state="closed" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent;-webkit-touch-callout:none" sizes="(min-width: 768px) 619px, 100vw" srcSet="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-640,q-80/cap-transparent-43.webp 640w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-768,q-80/cap-transparent-43.webp 768w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-896,q-80/cap-transparent-43.webp 896w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-1080,q-80/cap-transparent-43.webp 1080w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-1280,q-80/cap-transparent-43.webp 1280w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-1920,q-80/cap-transparent-43.webp 1920w" src="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fcap-transparent-43.png/tr:w-1920,q-80/cap-transparent-43.webp"/></div><div class="flex flex-col items-start gap-5 xl:gap-[30px]"><span class="inline-flex w-fit items-center border rounded-xs bg-landing-accent-soft px-[5px] py-[2px] md:px-[11px] md:py-[3px] border-landing-border text-landing-ink font-hal text-landing-sm md:text-landing-body">Transparency</span><h3 class="max-w-[550px] font-heading text-landing-h3-m font-medium text-landing-ink md:text-heading-3xl xl:text-landing-h3">Cutouts straight out of the API</h3><p class="max-w-[505px] font-hal text-landing-sm text-landing-ink md:text-landing-body">Set <code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">background</code> to<!-- --> <code class="rounded-xs border border-landing-border bg-white px-1.5 py-0.5 font-hal-mono text-landing-sm">transparent</code> with a PNG or WebP output and the model returns a real alpha channel, so product shots and icons drop straight onto a layout with no rotoscoping step in between.</p></div></div></div></div></section><section id="successive-editing" class="relative overflow-hidden border-t border-landing-border bg-white"><div class="relative mx-auto w-full max-w-[1237px] px-3 py-[50px] min-[1320px]:px-0 md:px-8 md:py-24 xl:py-[138px]"><div class="flex flex-col gap-5 md:gap-10"><span class="inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title">Successive editing</span><h2 class="max-w-[824px] font-heading text-landing-h2-m font-medium text-landing-ink md:text-heading-5xl xl:text-landing-h2">Three rounds, one thing changed each time</h2><p class="max-w-[723px] font-hal text-landing-sm text-landing-ink md:text-landing-body">Each frame is the previous frame sent back through the edit endpoint with a new instruction. The furniture, the rug and the framing carry through untouched while one thing changes per pass.</p></div><ol class="mt-[30px] grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-[60px] lg:grid-cols-4"><li class="flex flex-col"><div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl border border-landing-border bg-landing-surface"><img alt="AI-generated interior photograph of a mid-century living room with a pale oatmeal sofa and a bare wall above it" data-state="closed" loading="lazy" decoding="async" data-nimg="fill" class="h-full w-full object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent;-webkit-touch-callout:none" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw" srcSet="https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-0.jpg/tr:w-256,q-80/edit-0.webp 256w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-0.jpg/tr:w-384,q-80/edit-0.webp 384w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-0.jpg/tr:w-512,q-80/edit-0.webp 512w, https://refinery.fal.media/url/https%3A%2F%2Fir7z8qsacw4tk54b.public.blob.vercel-storage.com%2Fgpt-image-2.5%2Fv2%2Fedit-0.jpg/tr:w-640,q-80/edi