erflow-hidden border-t border-landing-border bg-landing-fill\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"relative mx-auto w-full max-w-[1237px] px-3 py-[50px] min-[1320px]:px-0 md:px-8 md:py-24 xl:py-[138px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-5 md:gap-10\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex w-fit items-center border rounded-[5px] bg-transparent px-[7px] py-1.5 md:px-3 md:py-2.5 border-landing-accent text-landing-accent font-heading font-medium text-landing-sm md:text-landing-title\",\"children\":\"Pricing\"}],[\"$\",\"h2\",null,{\"className\":\"max-w-[824px] font-heading text-landing-h2-m font-medium text-landing-ink md:text-heading-5xl xl:text-landing-h2\",\"children\":\"GPT Image 2.5 pricing\"}],[\"$\",\"p\",null,{\"className\":\"max-w-[723px] font-hal text-landing-sm text-landing-ink md:text-landing-body\",\"children\":\"Cost per image at the canonical sizes. Flare and Sunburst are priced identically, so the variant choice is free. Editing costs a little more than generating, because the reference image is billed as input.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-[30px] overflow-x-auto md:mt-[60px]\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full min-w-[860px] border-collapse text-left\",\"children\":[[\"$\",\"thead\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"rowSpan\":2,\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap text-landing-body-m md:text-landing-body align-bottom font-heading font-medium text-landing-ink\",\"children\":\"Size\"}],[\"$\",\"th\",null,{\"scope\":\"colgroup\",\"colSpan\":3,\"className\":\"border-b border-landing-border py-3 pr-6 text-landing-body-m md:text-landing-body font-heading font-medium text-landing-ink\",\"children\":\"Text to image\"}],[\"$\",\"th\",null,{\"scope\":\"colgroup\",\"colSpan\":3,\"className\":\"border-b border-landing-border py-3 pr-6 text-landing-body-m md:text-landing-body font-heading font-medium text-landing-ink\",\"children\":\"Editing\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"Low\",\"\"]}],[\"$\",\"th\",\"1\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"Medium\",\"\"]}],[\"$\",\"th\",\"2\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"High\",\" (default)\"]}],[\"$\",\"th\",\"3\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"Low\",\"\"]}],[\"$\",\"th\",\"4\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"Medium\",\"\"]}],[\"$\",\"th\",\"5\",{\"scope\":\"col\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-hal text-landing-sm font-normal text-landing-ink/60\",\"children\":[\"High\",\" (default)\"]}]]}]]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"1024 x 768\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap font-heading font-medium\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-landing-body-m md:text-landing-body block text-landing-ink\",\"children\":\"1024 x 768\"}],\"$undefined\"]}],[[\"$\",\"td\",\"0\",{\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap text-landing-body-m md:text-landing-body font-hal text-landing-ink/80\",\"children\":\"$$0.0041\"}],[\"$\",\"td\",\"1\",{\"className\":\"border-b border-landing-border py-4 pr-6 whitespace-nowrap text-landing-body-m md:text-landing-body font-hal text-landing-ink/80\",\"children\":\"$$0.0091\"}],\"$L61\",\"$L62\",\"$L63\",\"$L64\"]]}],\"$L65\",\"$L66\",\"$L67\",\"$L68\",\"$L69\"]}]]}]}],\"$L6a\"]}]]}]\n3f:[\"$\",\"$L6b\",null,{\"title\":\"How to call the GPT Image 2.5 API\",\"description\":\"The client handles the queue protocol, polls for status and returns the result when the request completes. All four endpoints take the same parameters.\",\"examples\":[{\"label\":\"Flare: text to image\",\"js\":\"import { fal } from \\\"@fal-ai/client\\\";\\n\\nconst result = await fal.subscribe(\\\"openai/gpt-image-2.5/flare/text-to-image\\\", {\\n  input: {\\n    prompt:\\n      \\\"A SaaS analytics dashboard with a left sidebar, four stat tiles and a labelled revenue chart, clean modern interface design\\\",\\n    image_size: \\\"landscape_4_3\\\",\\n    quality: \\\"high\\\",\\n  },\\n  logs: true,\\n  onQueueUpdate: (update) =\u003e {\\n    if (update.status === \\\"IN_PROGRESS\\\") {\\n      update.logs.map((log) =\u003e log.message).forEach(console.log);\\n    }\\n  },\\n});\\n\\nconsole.log(result.data);\\nconsole.log(result.requestId);\",\"python\":\"import fal_client\\n\\ndef on_queue_update(update):\\n    if isinstance(update, fal_client.InProgress):\\n        for log in update.logs:\\n            print(log[\\\"message\\\"])\\n\\nresult = fal_client.subscribe(\\n    \\\"openai/gpt-image-2.5/flare/text-to-image\\\",\\n    arguments={\\n        \\\"prompt\\\": \\\"A SaaS analytics dashboard with a left sidebar, four stat tiles and a labelled revenue chart, clean modern interface design\\\",\\n        \\\"image_size\\\": \\\"landscape_4_3\\\",\\n        \\\"quality\\\": \\\"high\\\",\\n    },\\n    with_logs=True,\\n    on_queue_update=on_queue_update,\\n)\\n\\nprint(result)\"},{\"label\":\"Sunburst: 4K detail\",\"js\":\"import { fal } from \\\"@fal-ai/client\\\";\\n\\n// Explicit sizes are allowed as well as the presets: both edges must be a\\n// multiple of 16, the long edge caps at 3840px, and the aspect ratio at 3:1.\\nconst result = await fal.subscribe(\\\"openai/gpt-image-2.5/sunburst/text-to-image\\\", {\\n  input: {\\n    prompt:\\n      \\\"Extreme macro of an open mechanical watch movement, ruby jewel bearings and Geneva striping under raking light\\\",\\n    image_size: { width: 3840, height: 2160 },\\n    quality: \\\"xhigh\\\",\\n  },\\n  logs: true,\\n});\\n\\nconsole.log(result.data);\",\"python\":\"import fal_client\\n\\n# Explicit sizes are allowed as well as the presets: both edges must be a\\n# multiple of 16, the long edge caps at 3840px, and the aspect ratio at 3:1.\\nresult = fal_client.subscribe(\\n    \\\"openai/gpt-image-2.5/sunburst/text-to-image\\\",\\n    arguments={\\n        \\\"prompt\\\": \\\"Extreme macro of an open mechanical watch movement, ruby jewel bearings and Geneva striping under raking light\\\",\\n        \\\"image_size\\\": {\\\"width\\\": 3840, \\\"height\\\": 2160},\\n        \\\"quality\\\": \\\"xhigh\\\",\\n    },\\n    with_logs=True,\\n)\\n\\nprint(result)\"},{\"label\":\"Editing\",\"js\":\"import { fal } from \\\"@fal-ai/client\\\";\\n\\n// Up to 16 reference images. Pass mask_url to confine the change to a region,\\n// and feed a round's output back in as the next round's input.\\nconst result = await fal.subscribe(\\\"openai/gpt-image-2.5/flare/edit\\\", {\\n  input: {\\n    prompt:\\n      \\\"Reupholster the sofa in deep forest green velvet. Change nothing else in the room.\\\",\\n    image_urls: [\\\"https://example.com/living-room.jpg\\\"],\\n    quality: \\\"high\\\",\\n  },\\n  logs: true,\\n});\\n\\nconsole.log(result.data);\",\"python\":\"import fal_client\\n\\n# Up to 16 reference images. Pass mask_url to confine the change to a region,\\n# and feed a round's output back in as the next round's input.\\nresult = fal_client.subscribe(\\n    \\\"openai/gpt-image-2.5/flare/edit\\\",\\n    arguments={\\n        \\\"prompt\\\": \\\"Reupholster the sofa in deep forest green velvet. Change nothing else in the room.\\\",\\n        \\\"image_urls\\\": [\\\"https://example.com/living-room.jpg\\\"],\\n        \\\"quality\\\": \\\"high\\\",\\n    },\\n    with_logs=True,\\n)\\n\\nprint(result)\"},{\"label\":\"Transparent background\",\"js\":\"import { fal } from \\\"@fal-ai/client\\\";\\n\\n// A real alpha channel, so PNG or WebP output rather than JPEG.\\nconst result = await fal.subscribe(\\\"openai/gpt-image-2.5/flare/text-to-image\\\", {\\n  input: {\\n    prompt: \\\"A high-top running shoe in oxide orange and bone white at a three-quarter angle, sharp studio lighting\\\",\\n    image_size: \\\"square_hd\\\",\\n    background: \\\"transparent\\\",\\n    output_format: \\\"png\\\",\\n    num_images: 4,\\n  },\\n  logs: true,\\n});\\n\\nconsole.log(result.data);\",\"python\":\"import fal_client\\n\\n# A real alpha channel, so PNG or WebP output rather than JPEG.\\nresult = fal_client.subscribe(\\n    \\\"openai/gpt-image-2.5/flare/text-to-image\\\",\\n    arguments={\\n        \\\"prompt\\\": \\\"A high-top running shoe in oxide orange and bone white at a three-quarter angle, sharp studio lighting\\\",\\n        \\\"image_size\\\": \\\"square_hd\\\",\\n        \\\"background\\\": \\\"transparent\\\",\\n        \\\"output_format\\\": \\\"png\\\",\\n        \\\"num_images\\\": 4,\\n    },\\n    with_logs=True,\\n)\\n\\nprint(result)\"}],\"decor\":\"$L6c\"}]\n40:[\"$\",\"section\",null,{\"className\":\"relative overflow-hidden border-t border-landing-border bg-white\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":true,\"className\":\"pointer-events-none absolute inset-0\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L35\",null,{\"src\":\"/landing/v2/_decor/blue/industries-cluster-right.svg\",\"alt\":\"\",\"width\":234,\"height\":202,\"className\":\"absolute top-[34px] right-0 hidden lg:block\",\"loading\":\"lazy\"}],[\"$\",\"$L35\",null,{\"src