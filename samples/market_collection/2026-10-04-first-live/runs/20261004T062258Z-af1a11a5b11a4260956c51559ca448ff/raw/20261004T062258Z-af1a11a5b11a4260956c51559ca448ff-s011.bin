":"usage-and-diagnostics","LibraryCode":"modelark","ParentCode":"ark-cli-command-reference","Title":"Usage & Diagnostics","Index":15989667219456,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"tools-and-platform","next":"managed-agents"},"managed-agents":{"value":{"DocumentID":121372,"LibraryID":178,"ParentID":121365,"DocumentCode":"managed-agents","LibraryCode":"modelark","ParentCode":"ark-cli-command-reference","Title":"Managed Agents","Index":15989667288064,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"usage-and-diagnostics","next":"ark-document-skills"},"ai-suite-skills":{"value":{"DocumentID":121758,"LibraryID":178,"ParentID":121364,"DocumentCode":"ai-suite-skills","LibraryCode":"modelark","ParentCode":"ai-suite","Title":"Skills","Index":16017613342720,"Type":1,"Status":1,"SecondNav":{"ID":518,"Name":"AI Suite","Type":"custom","LibraryID":178,"DirStyle":"BoldExpand","Index":5,"Creator":"fumeng.fm@bytedance.com","Updater":"fumeng.fm@bytedance.com","PDFURL":"https:\u002F\u002Feps-common-private-johor.dualstack.ap-southeast-1.tos.bytepluses.com\u002Fcloud-doc\u002Feps-doc-center-pdf\u002FModelArk_AI%20Suite_1790687102.pdf","CreatedTime":"2026-09-24T14:21:25Z","UpdatedTime":"2026-09-29T13:05:03Z"}},"children":["ark-document-skills"]},"ark-document-skills":{"value":{"DocumentID":121753,"LibraryID":178,"ParentID":121758,"DocumentCode":"ark-document-skills","LibraryCode":"modelark","ParentCode":"ai-suite-skills","Title":"ModelArk documentation Skills","Index":16017670099968,"Type":0,"Status":2,"SecondNav":null},"children":[],"prev":"managed-agents"}}}},"(lang)\u002Fdocs\u002F(libcode)\u002F(doccode$)\u002Fpage":{"lang":"en","docType":0,"apiType":"online","isContentDoc":false,"isPanelDoc":false,"curLibCode":"modelark","curDocCode":"seedance-2-0-mini-fast-limited-time-discount","curLib":null,"curDoc":{"DocumentID":121627,"DocumentCode":"seedance-2-0-mini-fast-limited-time-discount","LibraryID":178,"LibraryCode":"modelark","ParentID":74750,"ParentCode":"1784098","Title":"Limited-time discount campaign rules for Seedance models","EnTitle":"Limited-time discount campaign rules for Seedance models","Keywords":"ModelArk","Content":"{\"version\":\"0.4.24\",\"data\":{\"0\":{\"ops\":[{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avad20t5sd\",\"lmkr\":\"1\"}},{\"insert\":\"This topic describes the limited-time discount campaign for Dreamina Seedance 2.0 fast and Dreamina Seedance 2.0 mini, including the campaign period, discounted prices, discount limits, billing method relationships, and frequently asked questions.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avc6h0t6i6\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"warning\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"ave000t71k\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"This campaign applies only to token usage billed on a pay-as-you-go basis. Resource packs are prepaid products and are not eligible for this pay-as-you-go discount campaign.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#campaign-overview\",\"heading\":\"h2\",\"lineId\":\"avfoc0t8bs\",\"lmkr\":\"1\"}},{\"insert\":\"Campaign overview\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rsdlb01su65eh6iccncojlhw4tyta7de98 csfg3ewfnpsu1g3lp3c61sbv7tsccv00n1\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#how-to-participate\",\"heading\":\"h3\",\"lineId\":\"avhdt0t96c\",\"lmkr\":\"1\"}},{\"insert\":\"How to participate\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avimb0ta75\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"To ensure stable service, you must meet either of the following requirements before activating a model:\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avk6r0tbaj\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"Recommended: Maintain a BytePlus account balance \\u003e USD 30. Top-up entry: \"},{\"insert\":\"Billing overview\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fconsole.byteplus.com\u002Ffinance\u002Foverview\\\",\\\"linkId\\\":\\\"FVQTiHgdlB\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avm0o0tck1\",\"list\":\"bullet2\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"Recommended: Purchase a dedicated AI Savings Plan at the USD 30 tier or above. Purchase entry: \"},{\"insert\":\"AI Savings Plan\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fconsole.byteplus.com\u002Fcommon-buy\u002FAI-SavingsPlans%7C%7Cd9urs77og65q382arfog\\\",\\\"linkId\\\":\\\"gyyIfCfx5E\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avnkp0td91\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"2\",\"start\":\"2\"}},{\"insert\":\"Go to the \"},{\"insert\":\"Model activation\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002FopenManagement\\\",\\\"linkId\\\":\\\"AJsqibbbto\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\" page and activate the model for online inference. The campaign discount then applies automatically.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avpxs0tefy\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"3\",\"start\":\"3\"}},{\"insert\":\"For API instructions, see \"},{\"insert\":\"Video Generation API\",\"attributes\":{\"hyperlink\":\"{\\\"href\\\":\\\"https:\u002F\u002Fai.byteplus.com\u002Fark\u002Fregion:ap-southeast-1\u002Fdocs\u002FModelArk\u002F1520757\\\",\\\"linkId\\\":\\\"E43IufNexf\\\",\\\"newTab\\\":false,\\\"target\\\":\\\"_self\\\"}\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#campaign-period\",\"heading\":\"h2\",\"lineId\":\"avs5y0tfbq\",\"lmkr\":\"1\"}},{\"insert\":\"Campaign period\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avtqc0tg6n\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"Seedance 2.0 fast \u002F mini: From 14:00 (UTC+8) on August 7, 2026 to 14:00 (UTC+8) on October 7, 2026.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avw1z0th19\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Note\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"avxv50tiy4\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Seedance 2.0 fast and Seedance 2.0 mini return to the list price after the campaign ends or after the discount cap is reached.\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\" Requests billed after the campaign ends, or later requests generated after the cumulative token usage billed at the discounted price reaches the cap for the corresponding model, are charged at the list price.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#discount-information\",\"heading\":\"h2\",\"lineId\":\"avzf40tj9t\",\"lmkr\":\"1\"}},{\"insert\":\"Discount information\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#discounted-prices\",\"heading\":\"h3\",\"lineId\":\"aw0xc0tk7b\",\"lmkr\":\"1\"}},{\"insert\":\"Discounted prices\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"aw26a0tlac\",\"lmkr\":\"1\"}},{\"insert\":\"During the campaign, the discounted token unit prices for Seedance 2.0 fast and Seedance 2.0 mini apply automatically when eligible usage is billed.\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rszl5h80eekz5w1imrg3b4gryfrfnyl74g cs757h1yts9sb6dh9eir9cd0mtu2kc5e8i\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#discount-limits\",\"heading\":\"h3\",\"lineId\":\"aw49k0tm5y\",\"lmkr\":\"1\"}},{\"insert\":\"Discount limits\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"aw64j0tnzw\",\"lmkr\":\"1\"}},{\"insert\":\"The Seedance 2.0 fast and Seedance 2.0 mini discounts apply only to enterprise users. After the cumulative token usage billed at the discounted price reaches the specified cap for each model, the discount no longer applies.\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs6k6jwgug7se1kbv360dhihqt13wgm5b4 cst8n458szj4zop0lanljwdp35qq5d3lfm\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"aw7zh0tout\",\"lmkr\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\",\\\"isTitle\\\":true}\"}},{\"insert\":\"Note\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"aw9tm0tprc\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"Token usage is counted separately for Seedance 2.0 fast and Seedance 2.0 mini. \"},{\"insert\":\"The discount caps for the two models do not affect each other\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awcij0tq1c\",\"list\":\"bullet1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\",\"tips\":\"{\\\"type\\\":\\\"warning\\\"}\"}},{\"insert\":\"The system automatically counts all token usage billed at the discounted price from 14:00 (UTC+8) on September 18, 2026 to 14:00 (UTC+8) on October 7, 2026. \"},{\"insert\":\"Token usage consumed before 14:00 (UTC+8) on September 18, 2026 is not included in the cap calculation\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\".\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#relationship-between-resource-packs-ai-savings-plans-and-pay-as-you-go-billing\",\"heading\":\"h2\",\"lineId\":\"awds90tr7t\",\"lmkr\":\"1\"}},{\"insert\":\"Relationship between resource packs, AI Savings Plans, and pay-as-you-go billing\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awfku0tsur\",\"lmkr\":\"1\"}},{\"insert\":\"BytePlus ModelArk provides three billing methods for Seedance 2.0 series models. Their relationship to this campaign is as follows.\\n\"},{\"insert\":\"*\",\"attributes\":{\"aceTable\":\"rs3l82cyl62541dwy08iwzh9k9wn8ncz2l csuet2k0gmjyl34wjmvs96fwys233pydik\",\"aceTableMode\":\"list\",\"full\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#additional-terms\",\"heading\":\"h2\",\"lineId\":\"awhel0tt5b\",\"lmkr\":\"1\"}},{\"insert\":\"Additional terms\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awjry0tu3i\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"1\",\"start\":\"1\"}},{\"insert\":\"Multiple accounts are considered the same user if they share the same mobile phone number, identity document number, or account ID, or are otherwise determined by BytePlus to be controlled by the same entity.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awlao0tv9q\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"2\",\"start\":\"2\"}},{\"insert\":\"BytePlus reserves the right to disqualify users who maliciously occupy campaign resources, place fraudulent bulk orders, use unconventional methods that compromise campaign fairness, or otherwise violate applicable service agreements and rules. BytePlus may reclaim campaign benefits and pursue legal liability when necessary.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awn2g0tweb\",\"list\":\"number1\",\"lmkr\":\"1\",\"origin-start\":\"3\",\"start\":\"3\"}},{\"insert\":\"BytePlus may change or adjust the campaign based on operational requirements, including but not limited to the campaign rules, available product quantities, and campaign period. Refer to the latest campaign page and BytePlus notices. Services and benefits already granted before a rule change or adjustment are not affected.\\n\"},{\"insert\":\"*\",\"attributes\":{\"anchor\":\"#frequently-asked-questions\",\"heading\":\"h2\",\"lineId\":\"awoe30txbt\",\"lmkr\":\"1\"}},{\"insert\":\"Frequently asked questions\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awq5y0tywp\",\"lmkr\":\"1\"}},{\"insert\":\"Is every eligible API call during the campaign period billed at the discounted price?\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awrec0tz8t\",\"lmkr\":\"1\"}},{\"insert\":\"For Seedance 2.0 fast and Seedance 2.0 mini, if the usage is billed during the campaign period and the corresponding model has not reached its discount cap, it is charged at the campaign price automatically.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awt020u057\",\"lmkr\":\"1\"}},{\"insert\":\"Do I need to claim or apply for the discount?\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awua30u1he\",\"lmkr\":\"1\"}},{\"insert\":\"No. After you meet the campaign requirements, eligible pay-as-you-go usage is automatically billed at the discounted price.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awvia0u2xs\",\"lmkr\":\"1\"}},{\"insert\":\"Can I receive the discount if I have already purchased a resource pack?\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"awyq00u3a7\",\"lmkr\":\"1\"}},{\"insert\":\"Resource packs are prepaid quotas purchased at the list price and are deducted before pay-as-you-go charges. The discount does not apply to usage offset by a resource pack. After the resource pack quota is exhausted, or when no resource pack is available, eligible pay-as-you-go usage is billed at the campaign price.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"ax0ll0u4yz\",\"lmkr\":\"1\"}},{\"insert\":\"Does an AI Savings Plan offset the amount before or after the campaign discount?\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"ax38w0u5zp\",\"lmkr\":\"1\"}},{\"insert\":\"It offsets the discounted amount. The pay-as-you-go charge is first calculated using the applicable price when the usage is billed, and the AI Savings Plan then offsets that discounted charge.\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"ax4gu0u6we\",\"lmkr\":\"1\"}},{\"insert\":\"Is pay-as-you-go billing more cost-effective than a resource pack during the campaign?\",\"attributes\":{\"bold\":\"true\"}},{\"insert\":\"\\n\"},{\"insert\":\"*\",\"attributes\":{\"lineId\":\"ax5y40u7cm\",\"lmkr\":\"1\"}},{\"insert\":\"Yes. We recommend using pay-as-you-go billing. Pay-as-you-go billing is suitable for on-demand or fluctuating usage, while resource packs are more suitable for stable usage when you prefer to prepay for quota. Estimate your usage before selecting a billing method to avoid unused resource pack quota expiring.\\n\\n\"}],\"zoneId\":\"0\",\"zoneType\":\"Z\"},\"cs757h1yts9sb6dh9eir9cd0mtu2kc5e8i\":{\"ops\":[{\"insert\":{\"id\":\"c1m4me2dd8d5c5f8gsacqhtys7ef6stzpl\"},\"attributes\":{\"backgroundColor\":\"{\\\"3iyw72s1\\\":\\\"\\\",\\\"y3lsnc6q\\\":\\\"\\\",\\\"whq19szf\\\":\\\"\\\",\\\"wcky4tvq\\\":\\\"\\\"}\",\"colWidth\":\"100\",\"colWidthSpan\":\"1.5\"}},{\"insert\":{\"id\":\"c19n5u3fs7b5pl0phyn9oo5ogjk4yr9fhz\"},\"attributes\":{\"backgroundColor\":\"{\\\"lh6hm5c9\\\":\\\"\\\",\\\"kkhcy7vp\\\":\\\"\\\",\\\"egi62of2\\\":\\\"\\\",\\\"isk11iuc\\\":\\\"\\\"}\",\"colWidth\":\"100\",\"colWidthSpan\":\"1.5\"}},{\"insert\":{\"id\":\"c12ms92kajttietsfek45jan5mzyltcace\"},\"attributes\":{\"backgroundColor\":\"{\\\"t4vry5z5\\\":\\\"\\\",\\\"sws786lr\\\":\\\"\\\",\\\"5hzu4svw\\\":\\\"\\\",\\\"aknajo54\\\":\\\"\\\"}\",\"colWidth\":\"100\",\"colWidthSpan\":\"1\"}},{\"insert\":{\"id\":\"c1t9n9r69ltzqpw5h7wtokw7j7o6ehtb8i\"},\"attributes\":{\"backgroundColor\":\"{\\\"8qzcrp02\\\":\\\"\\\",\\\"yv02gggw\\\":\\\"\\\",\\\"y4duv2n4\\\":\\\"\\\",\\\"tcj9zye8\\\":\\\"\\\"}\",\"colWidth\":\"100\",\"colWidthSpan\":\"1.5\",\"mergeCellID\":\"rj9q5l8u\"}},{\"insert\":{\"id\":\"c1a