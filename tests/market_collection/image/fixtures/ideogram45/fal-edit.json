{
  "endpointId": "ideogram/v4.5/edit",
  "model": {
    "id": "ideogram/v4.5/edit",
    "modelUrl": "https://fal.run/ideogram/v4.5/edit",
    "status": "public",
    "category": "image-to-image",
    "pricingInfoOverride": "Your request will cost **$0.008** per image with Very Low, **$0.03** with Low, **$0.06** with Medium, and **$0.22** with High quality. The image size does not change the price.",
    "description": "Ideogram 4.5 editing. Provide a source image and a prompt, plus up to 4 reference images (3 when a mask is used). edit_precision: regular (default) or high, which uses Precise Edit and restores unchanged pixels. Quality: very_low to high for regular, low to very_high for high precision. Output keeps the source size by default (image_size auto)."
  },
  "modelData": {
    "endpointId": "ideogram/v4.5/edit",
    "appData": {
      "metadata": {
        "openapi": {
          "components": {
            "schemas": {
              "EditInputV45": {
                "properties": {
                  "image_size": {
                    "default": "auto",
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/ImageSize"
                      },
                      {
                        "enum": [
                          "auto",
                          "square",
                          "square_hd",
                          "portrait_4_3",
                          "landscape_4_3",
                          "portrait_16_9",
                          "landscape_16_9"
                        ],
                        "type": "string"
                      }
                    ],
                    "ui": {
                      "important": true
                    },
                    "description": "auto preserves source geometry, downscaled by the provider if needed. Only unmasked regular edits accept named presets or custom sizes: dimensions >=256, multiples of 32, area <=4194304, ratio <=6:1. Named presets use standard fal dimensions.",
                    "title": "Image Size"
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Seed",
                    "description": "Random seed. Omit to choose automatically."
                  },
                  "mask_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Mask URL",
                    "description": "Mask matching the source dimensions. Black edits, white preserves. Must contain both regions after rounding."
                  },
                  "reference_image_urls": {
                    "ui": {
                      "important": true
                    },
                    "description": "Up to four references plus the primary source, or three references plus the primary source and mask.",
                    "title": "Reference Image URLs",
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edit_precision": {
                    "enum": [
                      "regular",
                      "high"
                    ],
                    "default": "regular",
                    "ui": {
                      "important": true
                    },
                    "description": "regular uses Generate; high uses Precise Edit with unchanged-pixel restoration. Both always prepare structured edit instructions.",
                    "title": "Edit Precision",
                    "type": "string"
                  },
                  "num_images": {
                    "minimum": 1,
                    "default": 1,
                    "description": "Number of images to generate.",
                    "maximum": 8,
                    "type": "integer",
                    "title": "Number of Images"
                  },
                  "image_url": {
                    "title": "Image URL",
                    "description": "Primary source image to edit.",
                    "type": "string"
                  },
                  "quality": {
                    "enum": [
                      "very_low",
                      "low",
                      "medium",
                      "high"
                    ],
                    "default": "medium",
                    "ui": {
                      "important": true
                    },
                    "description": "Quality tier for either edit precision. Defaults to medium.",
                    "title": "Quality",
                    "type": "string"
                  },
                  "prompt": {
                    "examples": [
                      "A colorful storefront with a sign reading hello"
                    ],
                    "type": "string",
                    "title": "Prompt",
                    "description": "The generation or editing prompt.",
                    "maxLength": 10000,
                    "minLength": 1
                  },
                  "sync_mode": {
                    "default": false,
                    "description": "Return image data directly in the response.",
                    "title": "Sync Mode",
                    "type": "boolean"
                  }
                },
                "x-fal-order-properties": [
                  "prompt",
                  "image_url",
                  "reference_image_urls",
                  "mask_url",
                  "edit_precision",
                  "quality",
                  "image_size",
                  "num_images",
                  "seed",
                  "sync_mode"
                ],
                "title": "EditInputV45",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "prompt",
                  "image_url"
                ]
              },
              "OutputV3": {
                "properties": {
                  "seed": {
                    "title": "Seed",
                    "description": "Seed used for the random number generator",
                    "type": "integer",
                    "examples": [
                      123456
                    ]
                  },
                  "images": {
                    "title": "Images",
                    "examples": [
                      [
                        {
                          "url": "https://v3.fal.media/files/penguin/lHdRabS80guysb8Zw1kul_image.png"
                        }
                      ]
                    ],
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/File"
                    }
                  }
                },
                "x-fal-order-properties": [
                  "images",
                  "seed"
                ],
                "title": "OutputV3",
                "type": "object",
                "required": [
                  "images",
                  "seed"
                ]
              },
              "HTTPValidationError": {
                "properties": {
                  "detail": {
                    "title": "Detail",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ValidationError"
                    }
                  }
                },
                "x-fal-order-properties": [
                  "detail"
                ],
                "title": "HTTPValidationError",
                "type": "object"
              },
              "ImageSize": {
                "properties": {
                  "width": {
                    "default": 512,
                    "exclusiveMinimum": 0,
                    "description": "The width of the generated image.",
                    "maximum": 14142,
                    "type": "integer",
                    "title": "Width"
                  },
                  "height": {
                    "default": 512,
                    "exclusiveMinimum": 0,
                    "description": "The height of the generated image.",
                    "maximum": 14142,
                    "type": "integer",
                    "title": "Height"
                  }
                },
                "x-fal-order-properties": [
                  "width",
                  "height"
                ],
                "title": "ImageSize",
                "type": "object"
              },
              "File": {
                "properties": {
                  "content_type": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Content Type",
                    "description": "The mime type of the file.",
                    "examples": [
                      "image/png"
                    ]
                  },
                  "file_name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "File Name",
                    "description": "The name of the file. It will be auto-generated if not provided.",
                    "examples": [
                      "z9RV14K95DvU.png"
                    ]
                  },
                  "file_size": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "File Size",
                    "description": "The size of the file in bytes.",
                    "examples": [
                      4404019
                    ]
                  },
                  "url": {
                    "title": "Url",
                    "description": "The URL where the file can be downloaded from.",
                    "type": "string"
                  }
                },
                "x-fal-order-properties": [
                  "url",
                  "content_type",
                  "file_name",
                  "file_size"
                ],
                "title": "File",
                "type": "object",
                "required": [
                  "url"
                ]
              },
              "ValidationError": {
                "properties": {
                  "msg": {
                    "title": "Message",
                    "type": "string"
                  },
                  "loc": {
                    "title": "Location",
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    }
                  },
                  "type": {
                    "title": "Error Type",
                    "type": "string"
                  }
                },
                "x-fal-order-properties": [
                  "loc",
                  "msg",
                  "type"
                ],
                "title": "ValidationError",
                "type": "object",
                "required": [
                  "loc",
                  "msg",
                  "type"
                ]
              }
            }
          },
          "paths": {
            "/edit": {
              "post": {
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/EditInputV45"
                      }
                    }
                  },
                  "required": true
                },
                "responses": {
                  "200": {
                    "description": "Successful Response",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/OutputV3"
                        }
                      }
                    }
                  },
                  "422": {
                    "description": "Validation Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/HTTPValidationError"
                        }
                      }
                    }
                  }
                },
                "summary": "Ideogram V45 Edit",
                "operationId": "ideogram_v45_edit_v4_5_edit_post"
              }
            }
          },
          "x-fal-order-paths": [
            "/edit"
          ],
          "info": {
            "version": "0.1.0",
            "title": "FastAPI"
          },
          "openapi": "3.1.0"
        }
      }
    }
  }
}
