{
  "endpointId": "ideogram/v4.5",
  "model": {
    "id": "ideogram/v4.5",
    "modelUrl": "https://fal.run/ideogram/v4.5",
    "status": "public",
    "category": "text-to-image",
    "pricingInfoOverride": "Your request will cost **$0.03** per image with Low, **$0.06** with Medium, and **$0.22** with High quality. The image size does not change the price.",
    "description": "Ideogram 4.5 text-to-image. Generate posters, logos, and designs with accurate typography. Quality: low, medium (default), or high; price does not depend on size. Output sizes: fal presets (square_hd by default, 4:3, 16:9) or one of 36 supported exact sizes. Up to 8 images per request. Prompt expansion is on by default."
  },
  "modelData": {
    "endpointId": "ideogram/v4.5",
    "appData": {
      "metadata": {
        "openapi": {
          "components": {
            "schemas": {
